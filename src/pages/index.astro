---
// The homepage, server-rendered: the frame and the (Index) list. This is the
// complete page without JS and with reduced motion. The filmstrip island
// (§9 step 4b) builds on top of it.
import Frame from '../components/Frame.astro';
import IndexList from '../components/IndexList.astro';
import Base from '../layouts/Base.astro';
---
<Base title="Nahuel D'Elias — Product engineer" description="[Identity line]" preload={['sans-400', 'sans-500', 'mono-400']}>
  <Frame>
    <main>
      <h1 class="visually-hidden">Nahuel D'Elias, product engineer: work</h1>
      <IndexList />
    </main>
  </Frame>
</Base>

<style>
  main {
    /* The list starts 150px down, as in the mock; the corners sit above it. */
    padding: 150px var(--grid-margin) var(--space-96);
  }
  @media (max-width: 639.98px) {
    main {
      padding-top: var(--space-32);
    }
  }
</style>
