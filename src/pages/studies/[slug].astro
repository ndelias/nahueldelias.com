---
// /studies/[slug]: a product study (§2), laid out like a part page without
// the hub around it. The body tells the story in order and places the
// decision and the versions where they belong (<Decision />, <Versions />);
// a body that doesn't place its decision gets it after the meta row.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import AfterLoad from '../../components/AfterLoad.astro';
import BodySection from '../../components/BodySection.astro';
import Comparisons from '../../components/Comparisons.astro';
import Decision from '../../components/Decision.astro';
import DeferredStyles from '../../components/DeferredStyles.astro';
import EntryHeader from '../../components/EntryHeader.astro';
import Facts from '../../components/Facts.astro';
import Figure from '../../components/Figure.astro';
import Frame from '../../components/Frame.astro';
import Gallery from '../../components/Gallery.astro';
import Icon from '../../components/Icon.astro';
import NextEntry from '../../components/NextEntry.astro';
import Row from '../../components/Row.astro';
import Versions from '../../components/Versions.astro';
import Base from '../../layouts/Base.astro';
import { entriesIn, lastUpdated, nextEntry, stackLine } from '../../lib/entries';
import reveal from '../../scripts/reveal.ts?worker&url';

export const getStaticPaths = (() =>
  entriesIn('studies').map((entry) => ({ params: { slug: entry.id }, props: { entry } }))) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
Astro.locals.entry = entry;
const { Content } = await render(entry);
const body = entry.body ?? '';
const placesDecision = /<Decision\b/.test(body);
const usesRows = /<Row\b/.test(body);
const updated = await lastUpdated();
const dates = `${data.dates.start} – ${data.dates.end ?? 'present'}`;
---
{/* Faces preloaded: the tagline's (sans 400, the LCP element) and the
    title's (sans 500). Mono loads on use. */}
<Base title={`${data.title} — Nahuel D'Elias`} description={data.tagline} noindex={data.fixture} preload={['sans-400', 'sans-500']}>
  <DeferredStyles slot="head" />
  <Frame>
    <a slot="top-center" class="back" href="/">(<Icon name="arrow-left" /> Index)</a>
    <main class="case container part-page study">
      {data.fixture && <p class="fixture mono muted">Fixture · a test entry for the templates, not real work</p>}
      <EntryHeader entry={entry} />

      <Facts
        facts={[
          { label: 'Role', value: data.role, span: 3 },
          { label: 'Dates', value: dates, span: 3, nums: true },
          { label: 'Stack', value: stackLine(data.stack), span: 3 },
          { label: 'Status', value: data.standing, span: 3 },
        ]}
      />

      {data.note && <p class="note">{data.note}</p>}

      {data.decision && !placesDecision && (
        <div class="decision defer" style="--defer-size: 186px">
          <Decision />
        </div>
      )}

      <article class="body">
        <Content components={{ BodySection, Comparisons, Decision, Figure, Gallery, Row, Versions }} />
      </article>

      {usesRows && <AfterLoad src={reveal} />}
      {data.disclaimer && <p class="disclaimer muted">{data.disclaimer}</p>}

      {nextEntry(entry) && <div class="next defer" style="--defer-size: 257px"><NextEntry entry={entry} /></div>}
    </main>
    {updated && (
      <span slot="bottom-start" class="muted">Updated <time datetime={updated.toISOString().slice(0, 10)}>{updated.toISOString().slice(0, 10)}</time></span>
    )}
    <a slot="bottom-center" class="back" href="/">(<Icon name="arrow-left" /> Index)</a>
  </Frame>
</Base>

<style>
  .back {
    color: inherit;
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .case {
    /* Clear the frame's fixed header (28px inset plus one mono line), then
       the mock's 140px, as on a case study. */
    padding-top: calc(var(--frame-inset-block) + 14px + 140px);
    padding-bottom: calc(var(--frame-inset-block) + 14px + 96px);
  }
  .fixture {
    position: absolute;
    top: calc(var(--frame-inset-block) + 14px + 96px);
    margin: 0;
  }
  /* The opening note, in the body's reading column. */
  .note {
    margin: 72px 0 0;
    max-width: 60ch;
  }
  @media (min-width: 640px) {
    .note {
      margin-left: calc((100% - 11 * var(--grid-gutter)) / 12 * 3 + 3 * var(--grid-gutter));
    }
  }
  .decision {
    margin-top: 88px;
  }
  .next {
    margin-top: 140px;
  }
  /* Every body block is below the fold: deferred (see .defer in base.css). */
  .body > :global(:not(script, style)) {
    content-visibility: auto;
    contain-intrinsic-block-size: auto 320px;
    overflow-clip-margin: 8px;
  }
  .body > :global(figure) {
    contain-intrinsic-block-size: auto 590px;
  }
  .body > :global(.versions) {
    contain-intrinsic-block-size: auto 521px;
  }
  .body > :global(.comparisons) {
    contain-intrinsic-block-size: auto 838px;
  }
  @media (max-width: 639.98px) {
    /* A 44px line box, not inline-flex: flex would trim the space after
       the arrow. */
    .back {
      display: inline-block;
      line-height: 44px;
    }
    .case {
      padding-top: var(--space-48);
      padding-bottom: var(--space-48);
    }
    .fixture {
      position: static;
      margin-bottom: var(--space-24);
    }
    .note {
      margin-top: var(--space-48);
    }
    .decision {
      margin-top: var(--space-64);
    }
    .next {
      margin-top: var(--space-96);
    }
  }
</style>
