---
// /work/[slug]: the case study template (§9 step 5). Every block renders only
// when the entry has what it needs: a hub gets its parts matrix, an entry
// with versions its provenance stack, and so on. Nothing renders empty.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import DecisionBlock from '../../components/DecisionBlock.astro';
import DeferredStyles from '../../components/DeferredStyles.astro';
import EntryHeader from '../../components/EntryHeader.astro';
import Facts from '../../components/Facts.astro';
import Figure from '../../components/Figure.astro';
import Frame from '../../components/Frame.astro';
import Icon from '../../components/Icon.astro';
import NextEntry from '../../components/NextEntry.astro';
import PartsMatrix from '../../components/PartsMatrix.astro';
import VersionsStack from '../../components/VersionsStack.astro';
import Base from '../../layouts/Base.astro';
import { entriesIn, lastUpdated, partsOf } from '../../lib/entries';

export const getStaticPaths = (() =>
  entriesIn('work').map((entry) => ({ params: { slug: entry.id }, props: { entry } }))) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const isHub = partsOf(entry).length > 0;
const updated = await lastUpdated();

const LINKS = { live: 'Live', repo: 'Repo', demo: 'Demo' } as const;
const links = (Object.keys(LINKS) as (keyof typeof LINKS)[]).filter((k) => data.links[k]).map((k) => ({ label: LINKS[k], href: data.links[k]! }));
const dates = `${data.dates.start} – ${data.dates.end ?? 'present'}`;
const hero = data.hero;
const heroMeta = hero?.video ? ['Walkthrough', 'muted', hero.duration].filter(Boolean).join(' · ') : undefined;
---
{/* Faces preloaded: the tagline's (sans 400, the LCP element on phones
    until a hero outgrows it) and the title's (sans 500). Mono loads on use. */}
<Base title={`${data.title} — Nahuel D'Elias`} description={data.tagline} noindex={data.fixture} preload={['sans-400', 'sans-500']}>
  <DeferredStyles slot="head" />
  <Frame>
    <a slot="top-center" class="back" href="/">(<Icon name="arrow-left" /> Index)</a>
    <main class="case container">
      {data.fixture && <p class="fixture mono muted">Fixture · a test entry for the templates, not real work</p>}
      <EntryHeader entry={entry} />

      <Facts
        facts={[
          { label: 'Role', value: data.role, span: 3 },
          { label: 'Dates', value: dates, span: 3, nums: true },
          { label: 'Stack', value: data.stack.join(' · '), span: 4 },
          { label: 'Links', links, span: 2 },
        ]}
      />

      {hero && (
        <div class="hero">
          <Figure layout="full" priority src={hero.src} dark={hero.dark} alt={hero.alt} video={hero.video} play="auto" caption={hero.caption} meta={heroMeta} />
        </div>
      )}

      {data.decision && (
        <div class="decision defer" style="--defer-size: 157px">
          <DecisionBlock decision={data.decision} intro={data.decision.intro ?? (isHub ? 'The call that shaped the whole product. Each part below has its own.' : undefined)} />
        </div>
      )}

      <article class="body">
        <Content />
      </article>

      <div class="parts defer" style="--defer-size: 547px"><PartsMatrix hub={entry} /></div>

      {data.versions && <div class="versions defer" style="--defer-size: 521px"><VersionsStack versions={data.versions} /></div>}

      <div class="defer" style="--defer-size: 257px"><NextEntry entry={entry} /></div>
    </main>
    {updated && (
      <span slot="bottom-start" class="muted">Updated <time datetime={updated.toISOString().slice(0, 10)}>{updated.toISOString().slice(0, 10)}</time></span>
    )}
    <a slot="bottom-center" class="back" href="/">(<Icon name="arrow-left" /> Index)</a>
  </Frame>
</Base>

<style>
  .back {
    color: inherit;
    text-decoration: none;
  }
  /* Phone: 44px targets, as in the frame. */
  @media (max-width: 639.98px) {
    /* A 44px line box, not inline-flex: flex would trim the space after
       the arrow. */
    .back {
      display: inline-block;
      line-height: 44px;
    }
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .case {
    /* Clear the frame's fixed header (28px inset plus one mono line), then
       the mock's 140px. The footer row sits in the last 32px + line. */
    padding-top: calc(var(--frame-inset-block) + 14px + 140px);
    padding-bottom: calc(var(--frame-inset-block) + 14px + 96px);
  }
  .fixture {
    position: absolute;
    top: calc(var(--frame-inset-block) + 14px + 96px);
    margin: 0;
  }
  .hero {
    margin-top: 56px;
  }
  .decision {
    margin-top: var(--space-96);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 72px;
    padding-top: var(--space-96);
    counter-reset: body-section;
  }
  /* Every body block is below the fold: deferred (see .defer in base.css). */
  .body > :global(:not(script, style)) {
    content-visibility: auto;
    contain-intrinsic-block-size: auto 320px;
    overflow-clip-margin: 8px;
  }
  .body > :global(figure) {
    contain-intrinsic-block-size: auto 590px;
  }
  .parts:not(:empty) {
    margin-top: 120px;
  }
  .versions {
    margin-top: 180px;
  }
  /* Phone (approved 2026-09-28): the section breaks scaled down. */
  @media (max-width: 639.98px) {
    .case {
      padding-top: var(--space-48);
      padding-bottom: var(--space-48);
    }
    .fixture {
      position: static;
      margin-bottom: var(--space-24);
    }
    .hero {
      margin-top: var(--space-32);
    }
    .decision,
    .body {
      margin-top: var(--space-64);
    }
    .body {
      padding-top: 0;
      gap: var(--space-64);
    }
    .parts:not(:empty) {
      margin-top: var(--space-96);
    }
    .versions {
      margin-top: var(--space-96);
    }
  }
</style>
