---
// /work/[hub]/[part]: a part of a hub. A part told in tabs opens on its
// first tab here; the others are /work/[hub]/[part]/[tab].
import type { GetStaticPaths } from 'astro';
import PartPage from '../../../components/PartPage.astro';
import { entriesIn, partSlug, partsOf } from '../../../lib/entries';

export const getStaticPaths = (() =>
  entriesIn('work').flatMap((hub) =>
    partsOf(hub).map((part) => ({ params: { slug: hub.id, part: partSlug(part) }, props: { part, hub } })),
  )) satisfies GetStaticPaths;

const { part, hub } = Astro.props;
---
<PartPage part={part} hub={hub} tab={part.data.tabs?.[0]} />
