---
// /work/[hub]/[part]: a part of a hub (§3 hub and parts, §9 step 5), from
// docs/design/Substudy.dc.html. Sibling navigation, a header with what the
// part shows, the meta row, the hero, its own decision, the MDX body (which
// places the screens with <Screens />; without it they follow the body),
// and prev/next cycling through the parts.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import DecisionBlock from '../../../components/DecisionBlock.astro';
import EntryHeader from '../../../components/EntryHeader.astro';
import Facts from '../../../components/Facts.astro';
import Figure from '../../../components/Figure.astro';
import Frame from '../../../components/Frame.astro';
import Gallery from '../../../components/Gallery.astro';
import Icon from '../../../components/Icon.astro';
import PartPager from '../../../components/PartPager.astro';
import PartsNav from '../../../components/PartsNav.astro';
import Base from '../../../layouts/Base.astro';
import { entriesIn, entryHref, entryNumber, lastUpdated, partSlug, partsOf } from '../../../lib/entries';

export const getStaticPaths = (() =>
  entriesIn('work').flatMap((hub) =>
    partsOf(hub).map((part) => ({ params: { slug: hub.id, part: partSlug(part) }, props: { part, hub } })),
  )) satisfies GetStaticPaths;

const { part, hub } = Astro.props;
const { data } = part;
Astro.locals.gallery = data.gallery;
const { Content } = await render(part);
// A body that doesn't place <Screens /> gets them after it: every part shows
// its gallery (§3 hub and parts).
const placesScreens = /<Screens\b/.test(part.body ?? '');
const updated = await lastUpdated();
const hero = data.hero;
const heroMeta = hero && hero.caption && (hero.video ? `${hero.caption} · muted` : hero.caption);
const hubHref = entryHref(hub)!;
---
{/* Faces preloaded: the tagline's (sans 400, the LCP element until a hero
    outgrows it) and the title's (sans 500). Mono loads on use. */}
<Base title={`${data.title} — ${hub.data.title} — Nahuel D'Elias`} description={data.tagline} noindex={data.fixture} preload={['sans-400', 'sans-500']}>
  <Frame>
    <a slot="top-center" class="back" href={hubHref}>(<Icon name="arrow-left" /> {hub.data.title})</a>
    <main class="case container">
      <PartsNav part={part} />
      {data.fixture && <p class="fixture mono muted">Fixture · a test entry for the templates, not real work</p>}
      <div class="header"><EntryHeader entry={part} /></div>

      <Facts
        facts={[
          { label: 'Role', value: data.role, span: 3 },
          { label: 'Partners', value: data.partners?.join(' · '), span: 3 },
          { label: 'Stack', value: data.stack.join(' · '), span: 4 },
          { label: 'Status', value: data.standing, span: 2 },
        ]}
      />

      {hero && (
        <div class="hero">
          <Figure
            layout="full"
            priority
            src={hero.src}
            dark={hero.dark}
            alt={hero.alt}
            video={hero.video}
            play="click"
            meta={heroMeta}
            caption={hero.video ? hero.duration : undefined}
            label={`${entryNumber(part)} · Hero`}
          />
        </div>
      )}

      {data.decision && (
        <div class="decision defer" style="--defer-size: 186px">
          <DecisionBlock decision={data.decision} intro={data.decision.intro} />
        </div>
      )}

      <article class="body">
        <Content components={{ Screens: Gallery }} />
        {!placesScreens && <Gallery />}
      </article>

      <div class="pager defer" style="--defer-size: 110px"><PartPager part={part} /></div>
    </main>
    {updated && (
      <span slot="bottom-start" class="muted">Updated <time datetime={updated.toISOString().slice(0, 10)}>{updated.toISOString().slice(0, 10)}</time></span>
    )}
    <a slot="bottom-center" class="back" href={hubHref}>(<Icon name="arrow-left" /> {hub.data.title})</a>
  </Frame>
</Base>

<style>
  .back {
    color: inherit;
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .case {
    /* Clear the frame's fixed header (28px inset plus one mono line), then
       the mock's 56px to the parts. */
    padding-top: calc(var(--frame-inset-block) + 14px + 56px);
    padding-bottom: calc(var(--frame-inset-block) + 14px + 96px);
  }
  .fixture {
    margin: var(--space-48) 0 0;
  }
  .header {
    padding-top: 112px;
  }
  .fixture + .header {
    padding-top: calc(112px - var(--space-48) - 14px);
  }
  .hero {
    margin-top: 56px;
  }
  .decision {
    margin-top: 88px;
  }
  /* Body blocks are 96px apart; the screens take 112 either side, and
     numbered sections 64 between them. */
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-96);
    padding-top: var(--space-96);
    counter-reset: body-section;
  }
  /* Every body block is below the fold: deferred (see .defer in base.css),
     with the mock's heights at 1440 as the first estimate. */
  .body > :global(:not(script, style)) {
    content-visibility: auto;
    contain-intrinsic-block-size: auto 110px;
    overflow-clip-margin: 8px;
  }
  .body > :global(figure) {
    contain-intrinsic-block-size: auto 301px;
  }
  .body > :global(.data-table) {
    contain-intrinsic-block-size: auto 195px;
  }
  .body > :global([data-gallery]) {
    contain-intrinsic-block-size: auto 1774px;
  }
  .body > :global([data-gallery]),
  .body > :global([data-gallery] ~ .body-section) {
    margin-top: 16px;
  }
  .body > :global(.body-section + .body-section) {
    margin-top: -32px;
  }
  .pager {
    margin-top: 140px;
  }
  @media (max-width: 639.98px) {
    /* A 44px line box, not inline-flex: flex would trim the space after
       the arrow. */
    .back {
      display: inline-block;
      line-height: 44px;
    }
    .case {
      padding-top: var(--space-24);
      padding-bottom: var(--space-48);
    }
    .fixture {
      margin-top: var(--space-24);
    }
    .header,
    .fixture + .header {
      padding-top: var(--space-32);
    }
    .hero {
      margin-top: var(--space-32);
    }
    .decision {
      margin-top: var(--space-64);
    }
    .body {
      gap: var(--space-64);
      padding-top: var(--space-64);
    }
    .body > :global([data-gallery]),
    .body > :global([data-gallery] ~ .body-section) {
      margin-top: 0;
    }
    .body > :global(.body-section + .body-section) {
      margin-top: -16px;
    }
    .pager {
      margin-top: var(--space-96);
    }
  }
</style>
