---
// A product study (§2), for /studies/[slug] and, for a study told in tabs,
// /studies/[slug]/[tab] (the open tab; the first is the study's own URL).
// Laid out like a part page without the hub around it: the header, the meta
// row, the opening note, the decision, then the MDX body, which places its
// tabs, diagrams and screens where the story needs them.
import { render } from 'astro:content';
import AfterLoad from './AfterLoad.astro';
import BodySection from './BodySection.astro';
import Comparisons from './Comparisons.astro';
import DecisionBlock from './DecisionBlock.astro';
import DeferredStyles from './DeferredStyles.astro';
import EntryHeader from './EntryHeader.astro';
import Facts from './Facts.astro';
import Figure from './Figure.astro';
import Frame from './Frame.astro';
import Gallery from './Gallery.astro';
import Icon from './Icon.astro';
import MobileDesign from './MobileDesign.astro';
import NextEntry from './NextEntry.astro';
import Points from './Points.astro';
import Row from './Row.astro';
import Steps from './Steps.astro';
import Tab from './Tab.astro';
import Tabs from './Tabs.astro';
import SystemFigure from './diagrams/SystemFigure.astro';
import Base from '../layouts/Base.astro';
import { entryHref, lastUpdated, nextEntry, stackLine } from '../lib/entries';
import type { Entry } from '../lib/entries';
import reveal from '../scripts/reveal.ts?worker&url';

type StudyTab = NonNullable<Entry['data']['tabs']>[number];
interface Props {
  entry: Entry;
  /** The open tab, for a study told in tabs. */
  tab?: StudyTab;
}

const { entry, tab } = Astro.props;
const { data } = entry;
const href = entryHref(entry)!;
// The open tab's screens are the page's, for <Steps />, <MobileDesign /> and
// <Comparisons /> in its <Tab>.
Astro.locals.gallery = tab?.gallery ?? data.gallery;
Astro.locals.comparisons = tab?.comparisons ?? data.comparisons;
Astro.locals.phones = tab ? tab.phones : data.phones;
if (tab && data.tabs) {
  Astro.locals.tabs = {
    open: tab,
    list: data.tabs.map((t, i) => ({ id: t.id, label: t.label, caption: t.caption, href: i === 0 ? href : `${href}${t.id}/` })),
  };
}
const { Content } = await render(entry);
const body = entry.body ?? '';
// Rows swipe in, look closer and play their clips from one script.
const usesRows = /<Row\b/.test(body);
const updated = await lastUpdated();
const dates = `${data.dates.start} – ${data.dates.end ?? 'present'}`;
const title = `${tab && tab !== data.tabs?.[0] ? `${tab.label} — ` : ''}${data.title} — Nahuel D'Elias`;
---
{/* Faces preloaded: the tagline's (sans 400, the LCP element) and the
    title's (sans 500). Mono loads on use. */}
<Base title={title} description={data.tagline} noindex={data.fixture} preload={['sans-400', 'sans-500']}>
  <DeferredStyles slot="head" />
  <Frame>
    <a slot="top-center" class="back" href="/">(<Icon name="arrow-left" /> Index)</a>
    <main class="case container part-page study">
      {data.fixture && <p class="fixture mono muted">Fixture · a test entry for the templates, not real work</p>}
      <EntryHeader entry={entry} />

      <Facts
        facts={[
          { label: 'Role', value: data.role, span: 3 },
          { label: 'Dates', value: dates, span: 3, nums: true },
          { label: 'Stack', value: stackLine(data.stack), span: 3 },
          { label: 'Status', value: data.standing, span: 3 },
        ]}
      />

      {/* Above the fold on a phone: in the first paint, not the deferred body. */}
      {data.note && <p class="note">{data.note}</p>}

      {data.decision && (
        <div class="decision defer" style="--defer-size: 186px">
          <DecisionBlock decision={data.decision} intro={data.decision.intro} />
        </div>
      )}

      <article class="body">
        <Content components={{ BodySection, Comparisons, Figure, Gallery, MobileDesign, Points, Row, Steps, SystemFigure, Tab, Tabs }} />
      </article>

      {usesRows && <AfterLoad src={reveal} />}
      {data.disclaimer && <p class="disclaimer muted">{data.disclaimer}</p>}

      {nextEntry(entry) && <div class="next defer" style="--defer-size: 257px"><NextEntry entry={entry} /></div>}
    </main>
    {updated && (
      <span slot="bottom-start" class="muted">Updated <time datetime={updated.toISOString().slice(0, 10)}>{updated.toISOString().slice(0, 10)}</time></span>
    )}
    <a slot="bottom-center" class="back" href="/">(<Icon name="arrow-left" /> Index)</a>
  </Frame>
</Base>

<style>
  .back {
    color: inherit;
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .case {
    /* Clear the frame's fixed header (28px inset plus one mono line), then
       the mock's 140px, as on a case study. */
    padding-top: calc(var(--frame-inset-block) + 14px + 140px);
    padding-bottom: calc(var(--frame-inset-block) + 14px + 96px);
  }
  .fixture {
    position: absolute;
    top: calc(var(--frame-inset-block) + 14px + 96px);
    margin: 0;
  }
  /* The opening note, in the body's reading column. */
  .note {
    margin: 72px 0 0;
    max-width: 60ch;
  }
  @media (min-width: 640px) {
    .note {
      margin-left: calc((100% - 11 * var(--grid-gutter)) / 12 * 3 + 3 * var(--grid-gutter));
    }
  }
  .decision {
    margin-top: 88px;
  }
  .next {
    margin-top: 140px;
  }
  /* Every body block is below the fold: deferred (see .defer in base.css),
     as on a part page. */
  .body > :global(:not(script, style)) {
    content-visibility: auto;
    contain-intrinsic-block-size: auto 320px;
    overflow-clip-margin: 8px;
  }
  /* The tab row stays rendered (it's what a tab switch keeps in place); the
     blocks in the open tab are deferred like the body's. */
  .body > :global(.tabbed) {
    content-visibility: visible;
  }
  .body :global(.tab-panel > :not(script, style)) {
    content-visibility: auto;
    contain-intrinsic-block-size: auto 320px;
    overflow-clip-margin: 8px;
  }
  .body :global(.tab-panel > .walkthrough) {
    contain-intrinsic-block-size: auto 560px;
  }
  .body :global(.tab-panel > .system-figure) {
    contain-intrinsic-block-size: auto 1072px;
  }
  .body :global(.tab-panel > .comparisons) {
    contain-intrinsic-block-size: auto 838px;
  }
  .body :global(.tab-panel > figure) {
    contain-intrinsic-block-size: auto 590px;
  }
  @media (max-width: 639.98px) {
    /* A 44px line box, not inline-flex: flex would trim the space after
       the arrow. */
    .back {
      display: inline-block;
      line-height: 44px;
    }
    .case {
      padding-top: var(--space-48);
      padding-bottom: var(--space-48);
    }
    .fixture {
      position: static;
      margin-bottom: var(--space-24);
    }
    .note {
      margin-top: var(--space-48);
    }
    .decision {
      margin-top: var(--space-64);
    }
    .next {
      margin-top: var(--space-96);
    }
  }
</style>
