---
// Previous and next part, cycling through the hub's parts: the last part's
// next is the first.
import type { Entry } from '../lib/entries';
import { entryHref, entryNumber, siblingsOf } from '../lib/entries';
import Icon from './Icon.astro';

interface Props {
  part: Entry;
}

const s = siblingsOf(Astro.props.part);
// Styles: src/styles/deferred.css (loaded after the page has; this
// component only renders below the fold).
---
{s && s.prev !== Astro.props.part && (
  <nav class="pager grid" aria-label="More parts">
    <a class="prev" href={entryHref(s.prev)} rel="prev">
      <span class="mono muted">(<Icon name="arrow-left" /> Prev) {entryNumber(s.prev)}</span>
      <span class="title">{s.prev.data.title}</span>
    </a>
    <a class="next" href={entryHref(s.next)} rel="next">
      <span class="mono muted">{entryNumber(s.next)} (Next <Icon name="arrow-right" />)</span>
      <span class="title">{s.next.data.title}</span>
    </a>
  </nav>
)}
