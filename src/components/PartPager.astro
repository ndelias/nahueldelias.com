---
// Previous and next part, cycling through the hub's parts: the last part's
// next is the first.
import type { Entry } from '../lib/entries';
import { entryHref, entryNumber, siblingsOf } from '../lib/entries';
import Icon from './Icon.astro';

interface Props {
  part: Entry;
}

const s = siblingsOf(Astro.props.part);
---
{s && s.prev !== Astro.props.part && (
  <nav class="pager grid" aria-label="More parts">
    <a class="prev" href={entryHref(s.prev)} rel="prev">
      <span class="mono muted">(<Icon name="arrow-left" /> Prev) {entryNumber(s.prev)}</span>
      <span class="title">{s.prev.data.title}</span>
    </a>
    <a class="next" href={entryHref(s.next)} rel="next">
      <span class="mono muted">{entryNumber(s.next)} (Next <Icon name="arrow-right" />)</span>
      <span class="title">{s.next.data.title}</span>
    </a>
  </nav>
)}

<style>
  .pager {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }
  a {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-24) 0;
    color: var(--ink);
    text-decoration: none;
  }
  .mono {
    line-height: normal;
  }
  .title {
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-h3);
    line-height: normal;
  }
  a:hover .title {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }
  @media (min-width: 640px) {
    .prev {
      grid-column: span 6;
    }
    .next {
      grid-column: 7 / span 6;
      align-items: flex-end;
      padding-left: var(--space-24);
      border-left: 1px solid var(--line);
    }
  }
  /* Phone: two stacked rows. */
  @media (max-width: 639.98px) {
    .next {
      border-top: 1px solid var(--line);
    }
  }
</style>
