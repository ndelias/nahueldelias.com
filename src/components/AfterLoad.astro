---
// Runs a behaviour script once the first content has painted (afterLoad,
// defined in Base.astro on top of afterPaint), so it never competes with the first paint. `src`
// is a script compiled on its own by Vite (import … from
// '../scripts/x.ts?worker&url': a self-contained bundle with no imports;
// "worker" is only the build mode, it runs on the page). The tag added here
// is the only reference to it.
interface Props {
  src: string;
}
const { src } = Astro.props;
---
<script is:inline set:html={`afterLoad(${JSON.stringify(src)})`} />
