---
// Manual theme switch. Every visit lands in light; this shows the theme it
// switches to, "(Dark)" in light mode, and saves the choice;
// Base.astro's inline script applies it before first paint on the next visit.
// CSS picks the visible label from the resolved theme, so it's right at first
// paint and nothing shifts when the script runs. Without JS it can't work, so
// it doesn't render.
---
<button class="theme-toggle mono" type="button" aria-label="Switch to dark theme" data-theme-toggle>
  <span class="to-dark">(Dark)</span><span class="to-light">(Light)</span>
</button>

<script>
  const root = document.documentElement;
  const current = () => (root.dataset.theme === 'dark' ? 'dark' : 'light');
  const other = () => (current() === 'dark' ? 'light' : 'dark');

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const sync = () => buttons.forEach((b) => b.setAttribute('aria-label', `Switch to ${other()} theme`));

  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const next = other();
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage blocked: the switch still works for this page view.
      }
      sync();
    }),
  );
  sync();
</script>

<style>
  .theme-toggle {
    display: none;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }
  :global(.js) .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
  }
  .to-light {
    display: none;
  }
  :global(:root[data-theme='dark']) .to-dark {
    display: none;
  }
  :global(:root[data-theme='dark']) .to-light {
    display: inline;
  }
</style>
