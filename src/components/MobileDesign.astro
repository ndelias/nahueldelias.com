---
// The flow on a phone (the page's `phones`, or the open tab's), for use in
// MDX: a few screens on the page, "See all" for the rest in the viewer.
import Gallery from './Gallery.astro';

const phones = Astro.locals.phones ?? [];
---
<Gallery items={phones.map((p) => ({ ...p, frame: 'phone' as const }))} label="Mobile design" intro="The same flow on a phone. Click any screen to see it full size." />
