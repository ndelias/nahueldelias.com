---
// A numbered body section of a case study, for use in MDX: number and label
// in the margin, heading and prose in the reading column, an optional note
// beside it. Numbered in order by a CSS counter on the article, so sections
// can be moved without renumbering.
//
//   <BodySection label="The bet" heading="Why remixes needed…" note="…">
//     Prose, as Markdown.
//   </BodySection>
interface Props {
  label: string;
  heading: string;
  note?: string;
}

const { label, heading, note } = Astro.props;
// Styles: src/styles/deferred.css (loaded after the page has; this
// component only renders below the fold).
---
<section class="body-section grid">
  <p class="margin mono muted"><span class="no" aria-hidden="true"></span><span class="label">{label}</span></p>
  <div class="prose">
    <h2 class="heading">{heading}</h2>
    <slot />
  </div>
  {note && (
    <aside class="note" aria-label={`Note: ${label}`}>
      <span class="mono muted">Note</span>
      <p class="muted">{note}</p>
    </aside>
  )}
</section>
