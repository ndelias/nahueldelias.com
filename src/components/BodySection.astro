---
// A numbered body section of a case study, for use in MDX: number and label
// in the margin, heading and prose in the reading column, an optional note
// beside it. Numbered in order by a CSS counter on the article, so sections
// can be moved without renumbering.
//
//   <BodySection label="The bet" heading="Why remixes needed…" note="…">
//     Prose, as Markdown.
//   </BodySection>
interface Props {
  label: string;
  heading: string;
  note?: string;
}

const { label, heading, note } = Astro.props;
---
<section class="body-section grid">
  <p class="margin mono muted"><span class="no" aria-hidden="true"></span><span class="label">{label}</span></p>
  <div class="prose">
    <h2 class="heading">{heading}</h2>
    <slot />
  </div>
  {note && (
    <aside class="note" aria-label={`Note: ${label}`}>
      <span class="mono muted">Note</span>
      <p class="muted">{note}</p>
    </aside>
  )}
</section>

<style>
  .body-section {
    counter-increment: body-section;
  }
  .margin {
    display: flex;
    gap: var(--space-12);
    align-items: baseline;
    margin: 0;
    line-height: normal;
  }
  .no::before {
    content: counter(body-section, decimal-leading-zero);
  }
  .label {
    color: var(--ink);
  }
  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }
  .heading {
    margin: 0;
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-h3);
    text-wrap: balance;
  }
  .prose :global(p) {
    margin: 0;
    font-size: var(--text-prose);
    line-height: var(--leading-prose);
  }
  .note {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .note .mono {
    font-size: var(--text-mono-sm);
    line-height: normal;
  }
  .note p {
    margin: 0;
    font-size: var(--text-caption);
    line-height: var(--leading-small);
  }
  @media (min-width: 640px) {
    .margin {
      grid-column: span 3;
      align-self: start;
    }
    .prose {
      grid-column: 4 / span 6;
    }
    .note {
      grid-column: 10 / span 3;
      padding-top: 52px;
    }
  }
  /* Phone: label row, then heading and prose, then the note. */
  @media (max-width: 639.98px) {
    .margin {
      margin-bottom: var(--space-12);
    }
    .note {
      margin-top: var(--space-24);
    }
  }
</style>
