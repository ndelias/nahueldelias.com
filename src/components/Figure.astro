---
// An image or a muted screen recording, with a caption. Usable in MDX.
//
//   <Figure src={still} alt="…" caption="…" />
//   <Figure src={poster} alt="…" video="/media/clip.mp4" caption="…" />
//
// With a video, the image is the poster and the markup carries no video
// source, so nothing loads until it's needed. Two ways it plays:
// - play="view" (default): muted, looped, only while in view, with a Pause
//   control (WCAG 2.2.2). Under reduced motion it never loads: the poster
//   stays.
// - play="auto": the page's walkthrough. Plays muted and looped on its own
//   while in view (after the first paint), with a Pause / Play button in its
//   corner (WCAG 2.2.2). Under reduced motion it doesn't start; the button
//   plays it.
// - play="click": a play button starts it, muted, with
//   native controls. The reader asked, so reduced motion doesn't block it.
// Without JS the poster is all there is and no control shows.
//
// Explicit dimensions from the image, so nothing shifts when it or the video
// arrives (§5).
import AfterLoad from './AfterLoad.astro';
import behaviour from '../scripts/figure.ts?worker&url';
import type { ImageMetadata } from 'astro';
import { HERO_SIZES, heroSources } from '../lib/posters';
import EntryImage from './EntryImage.astro';
import Text from './Text.astro';

interface Props {
  src: ImageMetadata;
  /** Dark-theme variant of the still. Used by a priority (hero) figure. */
  dark?: ImageMetadata;
  alt: string;
  video?: string;
  play?: 'view' | 'click' | 'auto';
  caption?: string;
  /** Left of the caption row: "Walkthrough · muted · 0:48". Hero only. */
  meta?: string;
  /** Mono label in the frame's corner, e.g. the entry number. */
  label?: string;
  /** inset: the body's reading and figure columns (4 / span 9). full: the page width. */
  layout?: 'inset' | 'full';
  /** The hero: likely the LCP element. In the HTML at first paint, eager,
   * fetchpriority high, AVIF and WebP at three widths, dark variant. */
  priority?: boolean;
  /** A priority figure's `sizes`, when it isn't the page width. */
  sizes?: string;
}

const { src, dark, alt, video, play = 'view', caption, meta, label, layout = 'inset', priority = false, sizes: heroSizes = HERO_SIZES } = Astro.props;
const hero = priority ? await heroSources(src, dark) : undefined;
const { width, height } = (src as ImageMetadata & { clone?: ImageMetadata }).clone ?? src;
const sizes = layout === 'full' ? '(min-width: 640px) calc(100vw - 96px), calc(100vw - 32px)' : '(min-width: 640px) 75vw, calc(100vw - 32px)';
const row = layout === 'full';
---
<figure class:list={['figure', layout === 'inset' && 'grid']} data-figure>
  <div class="inner">
    <div class="media" style={`aspect-ratio: ${width} / ${height}`}>
      {hero ? (
        <picture>
          {hero.dark && <source type="image/avif" srcset={hero.dark.avif} sizes={heroSizes} media="(prefers-color-scheme: dark)" data-dark data-hero />}
          {hero.dark && <source type="image/webp" srcset={hero.dark.webp} sizes={heroSizes} media="(prefers-color-scheme: dark)" data-dark data-hero />}
          <source type="image/avif" srcset={hero.light.avif} sizes={heroSizes} data-hero />
          <source type="image/webp" srcset={hero.light.webp} sizes={heroSizes} data-hero />
          <img class="still" src={hero.light.src} alt={alt} width={width} height={height} loading="eager" fetchpriority="high" />
        </picture>
      ) : (
        <EntryImage
          class="still"
          src={src}
          alt={alt}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          widths={[640, 1280, 1920, 2560].filter((w) => w <= width)}
          sizes={sizes}
        />
      )}
      {/* A theme chosen with the toggle overrides the system: point the dark
          sources at it before the image is picked. Tiny and inline. */}
      {hero?.dark && (
        <script is:inline>(function(){var t=document.documentElement.dataset.theme;if(t)document.querySelectorAll("source[data-hero][data-dark]").forEach(function(s){s.media=t==="dark"?"all":"not all"})})()</script>
      )}
      {video && (
        <video class="video" data-src={video} data-play={play} muted playsinline preload="none" width={width} height={height} aria-label={alt} loop={play !== 'click'} />
      )}
      {label && <span class="label mono" aria-hidden="true">{label}</span>}
      {video && play === 'click' && (
        <button class="play" type="button" data-figure-play aria-label="Play walkthrough, muted">
          <svg width="20" height="22" viewBox="0 0 18 20" aria-hidden="true"><path d="M2 1.5v17L16.5 10z" /></svg>
        </button>
      )}
      {video && play === 'auto' && (
        <button class="play" type="button" data-figure-toggle aria-label="Play walkthrough, muted">
          <svg width="20" height="22" viewBox="0 0 18 20" aria-hidden="true"><path class="p-play" d="M2 1.5v17L16.5 10z" /><path class="p-pause" d="M5 2v16M13 2v16" /></svg>
        </button>
      )}
    </div>
    {(caption || meta || (video && play === 'view')) && (
      <figcaption class:list={['caption', { row }]}>
        {meta && <span class="meta mono muted">{meta}</span>}
        {caption && <span class:list={[row ? 'mono muted' : 'text muted']}><Text text={caption} /></span>}
        {video && play === 'view' && (
          <button class="pause mono" type="button" data-figure-pause aria-pressed="false">(Pause)</button>
        )}
      </figcaption>
    )}
  </div>
</figure>

<AfterLoad src={behaviour} />

<style>
  .figure {
    margin: 0;
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .media {
    position: relative;
    width: 100%;
    background: var(--surface);
    overflow: hidden;
  }
  .media :global(.still),
  .video {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The recording covers the poster only once it's actually playing. */
  .video {
    opacity: 0;
  }
  .playing .video {
    opacity: 1;
  }
  .label {
    position: absolute;
    left: 14px;
    top: 12px;
    font-size: var(--text-mono-sm);
    line-height: normal;
    opacity: 0.7;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 72px;
    height: 72px;
    margin: -36px 0 0 -36px;
    /* Above the poster and the recording, whatever the source order. */
    z-index: 1;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    /* White on a dark disc, like the Pause in the corner: it sits over the
       recording, which is dark whatever the page's theme. */
    border: 1px solid #fff;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    cursor: pointer;
  }
  :global(.js) .play {
    display: flex;
  }
  /* With a pointer, the button shows only while it's over the recording (or
     the button has keyboard focus), fading in and out. Touch screens keep
     it: there's no hover to find it with. */
  @media (hover: hover) {
    :global(.js) .play {
      opacity: 0;
      transition: opacity 400ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .media:hover .play,
    .play:focus-visible {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .play {
      transition: none;
    }
  }
  .play path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  /* The walkthrough's button shows Play until its behaviour runs it; the
     running state (a small Pause in the corner) is in deferred.css, which
     loads with that behaviour. */
  .p-pause {
    display: none;
  }
  .caption {
    display: flex;
    gap: var(--space-16);
    align-items: baseline;
    line-height: normal;
  }
  .caption.row {
    justify-content: space-between;
    flex-wrap: wrap;
  }
  /* Alone in a full-width row, the caption still sits on the right (the
     meta line, alone, stays left). */
  /* Inset figures' caption text, their Pause control and their column are
     in src/styles/deferred.css: inset figures sit below the fold; the
     hero only needs what's here. */
  .caption.row > :only-child:not(.meta) {
    margin-left: auto;
  }
  /* Phone: the full-width caption row stacks. */
  @media (max-width: 639.98px) {
    .caption.row {
      flex-direction: column;
      gap: var(--space-4);
    }
    .caption.row > :only-child:not(.meta) {
      margin-left: 0;
    }
  }
</style>
