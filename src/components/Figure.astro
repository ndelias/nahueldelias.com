---
// An image or a muted screen recording, with a caption. Usable in MDX.
//
//   <Figure src={still} alt="…" caption="…" />
//   <Figure src={poster} alt="…" video="/media/clip.mp4" caption="…" />
//
// With a video, the image is the poster and the markup carries no video
// source, so nothing loads until it's needed. Two ways it plays:
// - play="view" (default): muted, looped, only while in view, with a Pause
//   control (WCAG 2.2.2). Under reduced motion it never loads: the poster
//   stays.
// - play="click": the page's walkthrough. A play button starts it, muted, with
//   native controls. The reader asked, so reduced motion doesn't block it.
// Without JS the poster is all there is and no control shows.
//
// Explicit dimensions from the image, so nothing shifts when it or the video
// arrives (§5).
import type { ImageMetadata } from 'astro';
import { HERO_SIZES, heroSources } from '../lib/posters';
import EntryImage from './EntryImage.astro';
import Text from './Text.astro';

interface Props {
  src: ImageMetadata;
  /** Dark-theme variant of the still. Used by a priority (hero) figure. */
  dark?: ImageMetadata;
  alt: string;
  video?: string;
  play?: 'view' | 'click';
  caption?: string;
  /** Left of the caption row: "Walkthrough · muted · 0:48". Hero only. */
  meta?: string;
  /** Mono label in the frame's corner, e.g. the entry number. */
  label?: string;
  /** inset: the body's reading and figure columns (4 / span 9). full: the page width. */
  layout?: 'inset' | 'full';
  /** The hero: likely the LCP element. In the HTML at first paint, eager,
   * fetchpriority high, AVIF and WebP at three widths, dark variant. */
  priority?: boolean;
}

const { src, dark, alt, video, play = 'view', caption, meta, label, layout = 'inset', priority = false } = Astro.props;
const hero = priority ? await heroSources(src, dark) : undefined;
const { width, height } = (src as ImageMetadata & { clone?: ImageMetadata }).clone ?? src;
const sizes = layout === 'full' ? '(min-width: 640px) calc(100vw - 96px), calc(100vw - 32px)' : '(min-width: 640px) 75vw, calc(100vw - 32px)';
const row = layout === 'full';
---
<figure class:list={['figure', layout === 'inset' && 'grid']} data-figure>
  <div class="inner">
    <div class="media" style={`aspect-ratio: ${width} / ${height}`}>
      {hero ? (
        <picture>
          {hero.dark && <source type="image/avif" srcset={hero.dark.avif} sizes={HERO_SIZES} media="(prefers-color-scheme: dark)" data-dark data-hero />}
          {hero.dark && <source type="image/webp" srcset={hero.dark.webp} sizes={HERO_SIZES} media="(prefers-color-scheme: dark)" data-dark data-hero />}
          <source type="image/avif" srcset={hero.light.avif} sizes={HERO_SIZES} data-hero />
          <source type="image/webp" srcset={hero.light.webp} sizes={HERO_SIZES} data-hero />
          <img class="still" src={hero.light.src} alt={alt} width={width} height={height} loading="eager" fetchpriority="high" />
        </picture>
      ) : (
        <EntryImage
          class="still"
          src={src}
          alt={alt}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          widths={[640, 1280, 1920, 2560].filter((w) => w <= width)}
          sizes={sizes}
        />
      )}
      {/* A theme chosen with the toggle overrides the system: point the dark
          sources at it before the image is picked. Tiny and inline. */}
      {hero?.dark && (
        <script is:inline>(function(){var t=document.documentElement.dataset.theme;if(t)document.querySelectorAll("source[data-hero][data-dark]").forEach(function(s){s.media=t==="dark"?"all":"not all"})})()</script>
      )}
      {video && (
        <video class="video" data-src={video} data-play={play} muted playsinline preload="none" width={width} height={height} aria-label={alt} loop={play === 'view'} />
      )}
      {label && <span class="label mono" aria-hidden="true">{label}</span>}
      {video && play === 'click' && (
        <button class="play" type="button" data-figure-play aria-label="Play walkthrough, muted">
          <svg width="20" height="22" viewBox="0 0 18 20" aria-hidden="true"><path d="M2 1.5v17L16.5 10z" /></svg>
        </button>
      )}
    </div>
    {(caption || meta || (video && play === 'view')) && (
      <figcaption class:list={['caption', { row }]}>
        {meta && <span class="meta mono muted">{meta}</span>}
        {caption && <span class:list={[row ? 'mono muted' : 'text muted']}><Text text={caption} /></span>}
        {video && play === 'view' && (
          <button class="pause mono" type="button" data-figure-pause aria-pressed="false">(Pause)</button>
        )}
      </figcaption>
    )}
  </div>
</figure>

<script>
  // One observer for every in-view recording on the page. A recording plays
  // while at least a quarter of it is visible, unless the reader paused it.
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const paused = new WeakSet<HTMLVideoElement>();

  const load = (v: HTMLVideoElement) => {
    if (!v.src && v.dataset.src) v.src = v.dataset.src;
  };
  const start = (v: HTMLVideoElement) => {
    load(v);
    v.play().then(
      () => v.closest('[data-figure]')?.classList.add('playing'),
      () => {},
    );
  };

  const observer = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        const v = target as HTMLVideoElement;
        if (isIntersecting && !paused.has(v) && !still.matches) start(v);
        else if (!v.paused) v.pause();
      }
    },
    { threshold: 0.25 },
  );

  for (const figure of document.querySelectorAll<HTMLElement>('[data-figure]')) {
    const v = figure.querySelector<HTMLVideoElement>('video[data-play="view"]');
    if (v) {
      observer.observe(v);
      const button = figure.querySelector<HTMLButtonElement>('[data-figure-pause]')!;
      button.addEventListener('click', () => {
        const pause = !paused.has(v);
        if (pause) {
          paused.add(v);
          v.pause();
        } else {
          paused.delete(v);
          start(v);
        }
        button.setAttribute('aria-pressed', String(pause));
        button.textContent = pause ? '(Play)' : '(Pause)';
      });
    }

    const clickable = figure.querySelector<HTMLVideoElement>('video[data-play="click"]');
    figure.querySelector<HTMLButtonElement>('[data-figure-play]')?.addEventListener('click', (event) => {
      if (!clickable) return;
      (event.currentTarget as HTMLElement).remove();
      clickable.controls = true;
      start(clickable);
      clickable.focus();
    });
  }

  // The hero's dark sources follow the theme toggle too.
  const root = document.documentElement;
  const heroDark = document.querySelectorAll<HTMLSourceElement>('source[data-hero][data-dark]');
  if (heroDark.length) {
    new MutationObserver(() => {
      const t = root.dataset.theme;
      heroDark.forEach((s) => (s.media = t ? (t === 'dark' ? 'all' : 'not all') : '(prefers-color-scheme: dark)'));
    }).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
  }

  // Turning reduced motion on mid-visit stops what's playing.
  still.addEventListener('change', () => {
    if (still.matches) for (const v of document.querySelectorAll<HTMLVideoElement>('video[data-play="view"]')) v.pause();
  });
</script>

<style>
  .figure {
    margin: 0;
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .media {
    position: relative;
    width: 100%;
    background: var(--surface);
    overflow: hidden;
  }
  .media :global(.still),
  .video {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The recording covers the poster only once it's actually playing. */
  .video {
    opacity: 0;
  }
  .playing .video {
    opacity: 1;
  }
  .label {
    position: absolute;
    left: 14px;
    top: 12px;
    font-size: var(--text-mono-sm);
    line-height: normal;
    opacity: 0.7;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 72px;
    height: 72px;
    margin: -36px 0 0 -36px;
    /* Above the poster and the recording, whatever the source order. */
    z-index: 1;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  :global(.js) .play {
    display: flex;
  }
  .play path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .caption {
    display: flex;
    gap: var(--space-16);
    align-items: baseline;
    line-height: normal;
  }
  .caption.row {
    justify-content: space-between;
    flex-wrap: wrap;
  }
  /* Alone in a full-width row, the caption still sits on the right (the
     meta line, alone, stays left). */
  .caption.row > :only-child:not(.meta) {
    margin-left: auto;
  }
  .text {
    max-width: 60ch;
    font-size: var(--text-caption);
    line-height: var(--leading-small);
  }
  .pause {
    display: none;
    margin-left: auto;
    min-height: 24px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  :global(.js) .pause {
    display: inline;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .pause {
      display: none;
    }
  }
  @media (min-width: 640px) {
    .grid .inner {
      grid-column: 4 / span 9;
    }
  }
  /* Phone: the full-width caption row stacks. */
  @media (max-width: 639.98px) {
    .caption.row {
      flex-direction: column;
      gap: var(--space-4);
    }
    .caption.row > :only-child:not(.meta) {
      margin-left: 0;
    }
  }
</style>
