---
// Screens (§3 gallery), laid out by frame type, numbered, each with the one
// thing to notice. Usable in MDX; part pages place it with <Screens />.
//
// Each screen is a link to its full-size file, so without JS it still opens.
// With JS the link opens a native <dialog> instead: Esc and the Close button
// close it, the arrow keys step through the screens, and focus goes back to
// the screen that opened it. No library.
//
// Screens marked `more` aren't on the page, only in the viewer: "See all N
// screens" opens it at the first one. That keeps a long gallery's HTML small
// enough for the page to arrive in one round trip (the HTML budget). The
// page keeps each screen's number in the full set, so the gaps say there's
// more.
//
// Layout (9 columns beside the intro): a desktop screen spans all 9, or 6
// beside a phone screen before it; a phone spans 3; a detail crop spans 9.
// Phones: desktop screens full width, phone and detail two to a row.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import type { FrameType } from '../lib/model';
import EntryImage from './EntryImage.astro';
import AfterLoad from './AfterLoad.astro';
import behaviour from '../scripts/gallery.ts?worker&url';

interface Props {
  /** Defaults to the page's gallery (Astro.locals.gallery), for <Screens />. */
  items?: { src: ImageMetadata; alt: string; caption?: string; frame: FrameType; more?: boolean }[];
  label?: string;
  intro?: string;
}

const { items = Astro.locals.gallery ?? [], label = 'Screens', intro = 'The flow as shipped. Click any screen to see it full size.' } = Astro.props;

// A phone is the 390 × 844 viewport the phone screens are captured at.
const RATIO: Record<FrameType, string> = { desktop: '16 / 10', phone: '390 / 844', detail: '21 / 9' };
const SPAN: Record<FrameType, number> = { desktop: 9, phone: 3, detail: 9 };
const SIZES: Record<FrameType, string> = {
  desktop: '(min-width: 640px) 70vw, calc(100vw - 32px)',
  phone: '(min-width: 640px) 22vw, 45vw',
  detail: '(min-width: 640px) 70vw, 45vw',
};

const meta = (src: ImageMetadata) => (src as ImageMetadata & { clone?: ImageMetadata }).clone ?? src;
const screens = await Promise.all(
  items.map(async (item, i) => {
    const { width, height, format } = meta(item.src);
    // Full size: the source as is for an SVG, else one WebP at its own width.
    const full = format === 'svg' ? item.src.src : (await getImage({ src: item.src, format: 'webp', width })).src;
    return { ...item, index: i, no: String(i + 1).padStart(2, '0'), full, width, height };
  }),
);
const shown = screens
  .filter((s) => !s.more)
  .map((s, i, list) => ({ ...s, span: s.frame === 'desktop' && list[i - 1]?.frame === 'phone' ? 6 : SPAN[s.frame] }));
// The viewer-only screens: their details are in screens.json next to the
// page (pages/work/[slug]/[part]/screens.json.ts), fetched when the viewer
// opens. The "See all" link goes to the first one's full-size file.
const extra = screens.filter((s) => s.more);
const extraUrl = `${Astro.url.pathname.replace(/\/?$/, '/')}screens.json`;
const id = `gallery-${label.toLowerCase().replace(/\W+/g, '-')}`;
// Styles: src/styles/deferred.css (loaded after first paint; this
// component only renders below the fold).
---
{screens.length > 0 && (
  <section class="gallery grid" aria-labelledby={`${id}-label`} data-gallery>
    <div class="intro">
      <h2 class="label mono muted" id={`${id}-label`}>{label}</h2>
      <p class="muted"><span class="when-js">{intro}</span><span class="when-no-js">{intro.replace('Click any screen to see it', 'Each screen links to it at')}</span></p>
    </div>
    <ol class="screens">
      {shown.map((s) => (
        <li class:list={['screen', s.frame]} style={`--span: ${s.span}`}>
          <figure>
            <a class="open" href={s.full} data-gallery-open={s.index} data-width={s.width} data-height={s.height} aria-describedby={`${id}-cap-${s.index}`}>
              <span class="frame" style={`aspect-ratio: ${RATIO[s.frame]}`}>
                <EntryImage class="shot" src={s.src} alt={s.alt} widths={(s.frame === 'phone' ? [480, 960] : [960, 1920]).filter((w) => w <= s.width)} sizes={SIZES[s.frame]} />
              </span>
              <span class="visually-hidden"> (opens full size)</span>
            </a>
            <figcaption id={`${id}-cap-${s.index}`} class:list={['caption', { first: s.index === 0 }]}>
              <span class="no mono">{s.no}</span>
              {s.caption && <span class="text muted">{s.caption}</span>}
            </figcaption>
          </figure>
        </li>
      ))}
    </ol>
    {extra.length > 0 && (
      <p class="see-all">
        <a class="mono" href={extra[0].full} data-gallery-all data-extra-url={extraUrl} data-total={screens.length}>
          See all {screens.length} screens <span class="muted">({extra.length} more)</span>
        </a>
      </p>
    )}

    <dialog class="viewer" aria-labelledby={`${id}-viewer-caption`} data-gallery-viewer>
      <div class="viewer-bar mono">
        <span class="count muted" data-viewer-count></span>
        <span class="viewer-nav">
          <button type="button" data-viewer-prev aria-label="Previous screen">(Prev)</button>
          <button type="button" data-viewer-next aria-label="Next screen">(Next)</button>
          <button type="button" data-viewer-close autofocus>(Close)</button>
        </span>
      </div>
      <img class="viewer-img" alt="" data-viewer-img />
      <p class="viewer-caption" id={`${id}-viewer-caption`} data-viewer-caption></p>
    </dialog>
  </section>
)}

<AfterLoad src={behaviour} />
