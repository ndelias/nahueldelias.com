---
// Screens (§3 gallery), laid out by frame type, numbered, each with the one
// thing to notice. Usable in MDX; part pages place it with <Screens />.
//
// Each screen is a link to its full-size file, so without JS it still opens.
// With JS the link opens a native <dialog> instead: Esc and the Close button
// close it, the arrow keys step through the screens, and focus goes back to
// the screen that opened it. No library.
//
// Layout (9 columns beside the intro): a desktop screen spans all 9, or 6
// beside a phone screen before it; a phone spans 3; a detail crop spans 9.
// Phones: desktop screens full width, phone and detail two to a row.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import type { FrameType } from '../lib/model';
import EntryImage from './EntryImage.astro';

interface Props {
  /** Defaults to the page's gallery (Astro.locals.gallery), for <Screens />. */
  items?: { src: ImageMetadata; alt: string; caption?: string; frame: FrameType }[];
  label?: string;
  intro?: string;
}

const { items = Astro.locals.gallery ?? [], label = 'Screens', intro = 'The flow as shipped. Click any screen to see it full size.' } = Astro.props;

const RATIO: Record<FrameType, string> = { desktop: '16 / 10', phone: '9 / 16', detail: '21 / 9' };
const SPAN: Record<FrameType, number> = { desktop: 9, phone: 3, detail: 9 };
const SIZES: Record<FrameType, string> = {
  desktop: '(min-width: 640px) 70vw, calc(100vw - 32px)',
  phone: '(min-width: 640px) 22vw, 45vw',
  detail: '(min-width: 640px) 70vw, 45vw',
};

const meta = (src: ImageMetadata) => (src as ImageMetadata & { clone?: ImageMetadata }).clone ?? src;
const screens = await Promise.all(
  items.map(async (item, i) => {
    const { width, height, format } = meta(item.src);
    // Full size: the source as is for an SVG, else one WebP at its own width.
    const full = format === 'svg' ? item.src.src : (await getImage({ src: item.src, format: 'webp', width })).src;
    const span = item.frame === 'desktop' && items[i - 1]?.frame === 'phone' ? 6 : SPAN[item.frame];
    return { ...item, no: String(i + 1).padStart(2, '0'), full, width, height, span };
  }),
);
const id = `gallery-${label.toLowerCase().replace(/\W+/g, '-')}`;
---
{screens.length > 0 && (
  <section class="gallery grid" aria-labelledby={`${id}-label`} data-gallery>
    <div class="intro">
      <h2 class="label mono muted" id={`${id}-label`}>{label}</h2>
      <p class="muted"><span class="when-js">{intro}</span><span class="when-no-js">{intro.replace('Click any screen to see it', 'Each screen links to it at')}</span></p>
    </div>
    <ol class="screens">
      {screens.map((s, i) => (
        <li class:list={['screen', s.frame]} style={`--span: ${s.span}`}>
          <figure>
            <a class="open" href={s.full} data-gallery-open={i} data-full={s.full} data-width={s.width} data-height={s.height} aria-describedby={`${id}-cap-${i}`}>
              <span class="frame" style={`aspect-ratio: ${RATIO[s.frame]}`}>
                <EntryImage class="shot" src={s.src} alt={s.alt} widths={[480, 960, 1440, 1920].filter((w) => w <= s.width)} sizes={SIZES[s.frame]} />
              </span>
              <span class="visually-hidden"> (opens full size)</span>
            </a>
            <figcaption id={`${id}-cap-${i}`} class:list={['caption', { first: i === 0 }]}>
              <span class="no mono">{s.no}</span>
              {s.caption && <span class="text muted">{s.caption}</span>}
            </figcaption>
          </figure>
        </li>
      ))}
    </ol>

    <dialog class="viewer" aria-labelledby={`${id}-viewer-caption`} data-gallery-viewer>
      <div class="viewer-bar mono">
        <span class="count muted" data-viewer-count></span>
        <span class="viewer-nav">
          <button type="button" data-viewer-prev aria-label="Previous screen">(Prev)</button>
          <button type="button" data-viewer-next aria-label="Next screen">(Next)</button>
          <button type="button" data-viewer-close autofocus>(Close)</button>
        </span>
      </div>
      <img class="viewer-img" alt="" data-viewer-img />
      <p class="viewer-caption" id={`${id}-viewer-caption`} data-viewer-caption></p>
    </dialog>
  </section>
)}

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-gallery-open]')];
    const dialog = root.querySelector<HTMLDialogElement>('[data-gallery-viewer]')!;
    const img = dialog.querySelector<HTMLImageElement>('[data-viewer-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-viewer-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-viewer-count]')!;
    const total = String(links.length).padStart(2, '0');
    let at = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      at = (i + links.length) % links.length;
      const link = links[at];
      const shot = link.querySelector('img')!;
      img.src = link.dataset.full!;
      img.width = Number(link.dataset.width);
      img.height = Number(link.dataset.height);
      img.alt = shot.alt;
      const text = link.closest('figure')!.querySelector('.text')?.textContent ?? '';
      caption.textContent = text || shot.alt;
      count.textContent = `${String(at + 1).padStart(2, '0')} / ${total}`;
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return; // new tab: let it
        event.preventDefault();
        opener = link;
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-viewer-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-viewer-prev]')!.addEventListener('click', () => show(at - 1));
    dialog.querySelector('[data-viewer-next]')!.addEventListener('click', () => show(at + 1));
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(at - 1);
      else if (event.key === 'ArrowRight') show(at + 1);
      else return;
      event.preventDefault();
    });
    // A click on the backdrop (outside the dialog's box) closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const r = dialog.getBoundingClientRect();
      const inside = event.clientX >= r.left && event.clientX <= r.right && event.clientY >= r.top && event.clientY <= r.bottom;
      if (!inside) dialog.close();
    });
    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
      opener?.focus();
    });
  }
</script>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .label {
    margin: 0;
    font-weight: var(--weight-regular);
    line-height: normal;
  }
  .intro p {
    margin: 0;
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  .when-js {
    display: none;
  }
  :global(.js) .when-js {
    display: inline;
  }
  :global(.js) .when-no-js {
    display: none;
  }
  .screens {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    row-gap: var(--space-32);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .screen {
    grid-column: span var(--span);
  }
  figure {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
  }
  .open {
    display: block;
    color: inherit;
  }
  .frame {
    display: block;
    width: 100%;
    overflow: hidden;
    background: var(--surface);
  }
  .frame :global(.shot) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .caption {
    display: flex;
    gap: var(--space-12);
    font-size: var(--text-caption);
    line-height: var(--leading-small);
  }
  .caption.first {
    gap: var(--space-16);
  }
  .no {
    color: var(--ink);
    line-height: inherit;
  }

  .viewer {
    width: min(100vw - 2 * var(--grid-margin), 1344px);
    max-height: calc(100vh - 2 * var(--space-32));
    padding: var(--space-16);
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
  }
  .viewer::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  .viewer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-12);
  }
  .viewer-nav {
    display: flex;
    gap: var(--space-16);
  }
  .viewer button {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }
  .viewer button:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .viewer-img {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(100vh - 2 * var(--space-32) - 140px);
    object-fit: contain;
    background: var(--surface);
  }
  .viewer-caption {
    margin: var(--space-12) 0 0;
    font-size: var(--text-caption);
    line-height: var(--leading-small);
    color: var(--muted);
  }

  @media (min-width: 640px) {
    .intro {
      grid-column: span 3;
    }
    .screens {
      grid-column: 4 / span 9;
    }
  }
  /* Phone: desktop screens full width, phone and detail two to a row; the
     viewer takes the whole screen. */
  @media (max-width: 639.98px) {
    .intro {
      margin-bottom: var(--space-24);
    }
    .screens {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-16);
    }
    .screen {
      grid-column: span 1;
    }
    .screen.desktop {
      grid-column: span 2;
    }
    .viewer {
      width: 100vw;
      max-width: 100vw;
      height: 100dvh;
      max-height: 100dvh;
      margin: 0;
      border: 0;
    }
    .viewer-img {
      max-height: calc(100dvh - 140px);
    }
  }
</style>
