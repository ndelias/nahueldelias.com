---
// The stylesheet for below-the-fold case study components
// (src/styles/deferred.css), added once the first content has painted
// (afterPaint, Base.astro), so it never competes with the first paint for
// the network. Without JS it's a plain stylesheet in <noscript>. Goes in
// Base's head slot.
//
// A link to a #fragment lands before these styles exist, measured against
// the unstyled blocks above it, and those blocks (content-visibility: auto)
// remember their unstyled heights while skipped. Once the styles apply, the
// blocks render for one frame to remember their real heights, and the link
// lands again, unless the reader has scrolled or typed since.
import href from '../styles/deferred.css?url';
---
<noscript><link rel="stylesheet" href={href} /></noscript>
{/* Minified by hand, like Base's inline script: it ships in the HTML of
    every case study page, which sits at the HTML budget. Readable:
      afterPaint: make <link rel=stylesheet href>; note any wheel,
      touchstart or keydown (m = 1); on load, if the URL has a #fragment
      and the reader hasn't moved (m), render the .body blocks for a frame
      (contentVisibility "visible"), land on the target, then clear it and
      land again. */}
<script is:inline set:html={`afterPaint(function(){var l=document.createElement("link"),m=0,f=function(){m=1};l.rel="stylesheet";l.href=${JSON.stringify(href)};["wheel","touchstart","keydown"].forEach(function(e){addEventListener(e,f,{once:true,passive:true})});l.onload=function(){var t=location.hash&&document.getElementById(decodeURIComponent(location.hash.slice(1)));if(!t||m)return;var b=document.querySelectorAll(".body>*"),c=function(v){b.forEach(function(e){e.style.contentVisibility=v})};c("visible");t.scrollIntoView();requestAnimationFrame(function(){setTimeout(function(){c("");t.scrollIntoView()})})};document.head.append(l)})`} />
