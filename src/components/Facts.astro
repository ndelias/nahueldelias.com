---
// The meta row under a case study's header: a few labeled facts on the
// grid, each spanning the columns the mock gives it. Facts without a value
// don't render. Phones: two to a row.
import Icon from './Icon.astro';

interface Fact {
  label: string;
  value?: string;
  links?: { label: string; href: string }[];
  span: number;
  nums?: boolean;
}

interface Props {
  facts: Fact[];
}

const facts = Astro.props.facts.filter((f) => f.value || f.links?.length);
---
{facts.length > 0 && (
  <dl class="facts grid">
    {facts.map((f) => (
      <div class="fact" style={`--span: ${f.span}`}>
        <dt class="mono muted">{f.label}</dt>
        {f.links ? (
          <dd class="links mono">{f.links.map((l) => <a href={l.href}>{l.label} <Icon name="arrow-up-right" /></a>)}</dd>
        ) : (
          <dd class:list={{ nums: f.nums }}>{f.value}</dd>
        )}
      </div>
    ))}
  </dl>
)}

<style>
  .facts {
    margin: 48px 0 0;
    padding-top: var(--space-16);
    border-top: 1px solid var(--ink);
    row-gap: var(--space-24);
  }
  .fact {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  dt {
    line-height: normal;
  }
  dd {
    margin: 0;
    font-size: var(--text-meta);
    line-height: 1.5;
  }
  .nums {
    font-variant-numeric: tabular-nums;
  }
  .links {
    display: flex;
    gap: var(--space-16);
    font-size: var(--text-mono-lg);
  }
  .links a {
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (min-width: 640px) {
    .fact {
      grid-column: span var(--span);
    }
  }
  @media (max-width: 639.98px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-16);
      margin-top: var(--space-32);
    }
  }
</style>
