---
// The decision (§3): chose, rejected, cost. Shared by the hub and its parts,
// and by any weight 1 or 2 entry. The intro line says what kind of decision
// this is: the whole product's on a hub, the part's own on a part.
interface Props {
  decision: { chose: string; rejected: string; cost: string };
  intro?: string;
}

const { decision, intro } = Astro.props;
const cells = [
  { label: 'Chose', text: decision.chose },
  { label: 'Rejected', text: decision.rejected, muted: true },
  { label: 'Cost', text: decision.cost },
];
// Styles: src/styles/deferred.css (loaded after the page has; this
// component only renders below the fold).
---
<section class="decision grid" aria-labelledby="decision-label">
  <div class="head">
    <h2 class="label mono" id="decision-label">The decision</h2>
    {intro && <p class="intro muted">{intro}</p>}
  </div>
  <dl class="cells">
    {cells.map((c) => (
      <div class="cell">
        <dt class="mono muted">{c.label}</dt>
        <dd class:list={['text', { muted: c.muted }]}>{c.text}</dd>
      </div>
    ))}
  </dl>
</section>
