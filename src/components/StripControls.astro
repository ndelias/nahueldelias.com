---
// The filmstrip's corner controls (§7.5), placed in the frame's slots: the
// (Index)/(Strip) switch top-center, Prev / Next bottom-center, out of the
// way while the reader heads down a hub's parts (data-parts-down). Wired by
// Filmstrip.astro's island. Like the strip, they exist only with JS and
// without reduced motion (data-strip-ui).
import Icon from './Icon.astro';

interface Props {
  part: 'toggle' | 'nav';
}

const { part } = Astro.props;
---
{part === 'toggle' && (
  <button class="control mono" type="button" data-strip-ui data-view-toggle data-view="strip" aria-label="Show as an index">
    <span class="to-index">(Index)</span><span class="to-strip">(Strip)</span>
  </button>
)}
{part === 'nav' && (
  <span class="nav" data-strip-ui>
    <button class="control mono" type="button" data-strip-prev aria-label="Previous project">(<Icon name="arrow-left" /> Prev)</button>
    <button class="control mono" type="button" data-strip-next aria-label="Next project">(Next <Icon name="arrow-right" />)</button>
  </span>
)}

<style>
  .control {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }
  /* The header's corner labels align on their baselines; a 44px toggle
     would push the row down. Phones get the 44px target. */
  [data-view-toggle] {
    min-height: 0;
  }
  @media (max-width: 639.98px) {
    [data-view-toggle] {
      min-height: 44px;
    }
  }
  .control:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .nav {
    display: flex;
    gap: 20px;
    transition:
      opacity 0.3s ease,
      visibility 0s;
  }
  :global(:root[data-parts-down]) .nav {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0s 0.3s;
  }
  .to-strip {
    display: none;
  }
  [data-view='index'] .to-index {
    display: none;
  }
  [data-view='index'] .to-strip {
    display: inline;
  }
</style>
