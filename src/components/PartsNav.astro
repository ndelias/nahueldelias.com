---
// Sibling navigation on a part page: every part of the hub, in build order.
// At rest it's one quiet row, number and title. Pointing at it (or tabbing
// into it) lowers the thumbnails over the page like a blind, and they roll
// back up when you leave. The current part at full strength with an accent
// rule, the others dimmed. Phones: a row of text tabs that scrolls sideways
// on its own, the current part scrolled into view, no thumbnails.
import type { Entry } from '../lib/entries';
import { entryHref, entryNumber, parentOf, partsOf } from '../lib/entries';
import EntryImage from './EntryImage.astro';

interface Props {
  part: Entry;
}

const { part } = Astro.props;
const hub = parentOf(part)!;
const parts = partsOf(hub);
// vers1ons' numbers carry its own color.
const brand = hub.id === 'vers1ons';
---
<nav class="parts-nav" aria-label={`Parts of ${hub.data.title}`} data-parts-nav>
  <ol style={`--n: ${parts.length}`}>
    {parts.map((p) => (
      <li>
        <a href={entryHref(p)} aria-current={p === part ? 'page' : undefined} class:list={['item mono', { current: p === part }]}>
          {/* Low priority: on phones these sit above the header, in view, and
              Chrome would raise them to High, where they'd compete with the
              tagline and hero for the largest paint. */}
          <span class="name"><span class:list={['no', { brand }]}>{entryNumber(p)}</span> <span class="title">{p.data.title}</span></span>
          <span class="thumb"><EntryImage src={p.data.cover.src} alt="" fetchpriority="low" /></span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<script>
  // Phones: bring the current part into view inside the strip, without
  // scrolling the page.
  for (const nav of document.querySelectorAll<HTMLElement>('[data-parts-nav]')) {
    const list = nav.querySelector('ol')!;
    const current = nav.querySelector<HTMLElement>('[aria-current="page"]')?.closest('li');
    if (current && list.scrollWidth > list.clientWidth) {
      list.scrollLeft = current.offsetLeft - (list.clientWidth - current.offsetWidth) / 2;
    }
  }
</script>

<style>
  ol {
    /* The offset parent for the scroll-into-view script. */
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .item {
    position: relative;
    display: block;
    padding-top: 10px;
    border-top: 2px solid var(--line);
    color: var(--muted);
    text-decoration: none;
    line-height: normal;
  }
  .item.current {
    border-top-color: var(--accent);
    color: var(--ink);
  }
  .name {
    display: flex;
    gap: var(--space-8);
  }
  .no.brand {
    color: var(--vers1ons);
  }
  /* The blind: each thumbnail hangs under its title, over the page, rolled
     up (clipped to nothing) until the row is pointed at or focused. Its
     shadow in the page's color covers the gutters and a margin below, so
     the thumbnails read as one panel. */
  .thumb {
    position: absolute;
    z-index: 2;
    top: calc(100% + 12px);
    left: 0;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 0 0 calc(var(--grid-gutter) / 2) var(--bg);
    clip-path: inset(0 0 100% 0);
    pointer-events: none;
  }
  .thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }
  .current .thumb :global(img) {
    opacity: 1;
  }
  [data-parts-nav]:hover .thumb,
  [data-parts-nav]:focus-within .thumb {
    clip-path: inset(0 calc(var(--grid-gutter) / -2) calc(var(--grid-gutter) / -2));
    pointer-events: auto;
  }
  .item:hover .title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .item:hover .thumb :global(img) {
    opacity: 0.8;
  }
  .current:hover .thumb :global(img) {
    opacity: 1;
  }
  /* Down in 0.55s, back up a touch quicker, after a beat, so passing over
     the row on the way somewhere else doesn't flap it. */
  @media (prefers-reduced-motion: no-preference) {
    .thumb {
      transition: clip-path 0.45s var(--ease) 0.12s;
    }
    [data-parts-nav]:hover .thumb,
    [data-parts-nav]:focus-within .thumb {
      transition: clip-path 0.55s var(--ease);
    }
    .thumb :global(img) {
      transition: opacity 0.2s var(--ease);
    }
  }
  /* Phone: one row of text tabs, number and title, scrolling sideways on
     its own. The current tab in ink with an accent underline; 44px targets.
     No thumbnails: hidden, and lazy, so they're never fetched. The row
     bleeds to the screen edges; the first and last tabs keep the gutter. No
     scroll snapping: a re-snap on resize would undo the script's centering. */
  @media (max-width: 639.98px) {
    ol {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      column-gap: var(--space-24);
      margin-inline: calc(-1 * var(--grid-margin));
      padding-inline: var(--grid-margin);
      overflow-x: auto;
      scrollbar-width: none;
      border-bottom: 1px solid var(--line);
    }
    .item {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: 0;
      border-top: 0;
      /* Sits on the row's rule. */
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      white-space: nowrap;
    }
    .item.current {
      border-bottom-color: var(--accent);
    }
    .thumb {
      display: none;
    }
  }
</style>
