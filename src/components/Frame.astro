---
// The four-corner mono frame (§7.5), inset by --frame-inset, outside the grid.
// Pages fill the other corners through slots: top-center, bottom-start and
// bottom-center (/work puts the strip's controls there).
//
// Nav items render only once they have somewhere to go, the same rule as
// sections: no dead links. The name leads home (/, the About page). On
// /work (`contact`), the bottom-right corner carries the resume (a new tab)
// and Contact (email), small.
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** The resume and Contact links in the bottom-right corner. */
  contact?: boolean;
}
const { contact = false } = Astro.props;

const CONTACT = 'mailto:njdelias@gmail.com';
const RESUME = '/nahuel-delias-resume.pdf';

const pages = Object.keys(import.meta.glob('../pages/**/*.astro'));
const exists = (path: string) => path === '/' || pages.some((p) => p === `../pages${path}.astro` || p === `../pages${path}/index.astro`);

const NAV = [
  { label: 'Work', href: '/work' },
  { label: 'About', href: '/' },
  { label: 'Log', href: '/log' },
].filter((item) => exists(item.href));

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (href === here ? 'page' : undefined);
const bottom = Astro.slots.has('bottom-start') || Astro.slots.has('bottom-center');
---
<div class="frame">
  <header class="corner top mono">
    <a class="name" href="/" aria-current={current('/')}>Nahuel D'Elias<span class="role muted"> · Product engineer</span></a>
    {Astro.slots.has('top-center') && <div class="center"><slot name="top-center" /></div>}
    <div class="end">
      <nav aria-label="Primary">
        {NAV.map((item) => <a href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
      </nav>
      <ThemeToggle />
    </div>
  </header>

  <slot />

  {(contact || bottom) && (
    <footer class="corner bottom mono">
      {Astro.slots.has('bottom-start') && <div class="start"><slot name="bottom-start" /></div>}
      {Astro.slots.has('bottom-center') && <div class="center"><slot name="bottom-center" /></div>}
      {contact && (
        <div class="contact">
          <a href={RESUME} target="_blank" rel="noopener">Resume <Icon name="arrow-up-right" /></a>
          <a href={CONTACT}>Contact <Icon name="arrow-up-right" /></a>
        </div>
      )}
    </footer>
  )}
</div>

<style>
  .frame {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    line-height: normal;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .corner {
    position: absolute;
    left: var(--frame-inset);
    right: var(--frame-inset);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: baseline;
  }
  .top {
    top: var(--frame-inset-block);
  }
  .bottom {
    bottom: var(--frame-inset-block);
  }
  .start {
    grid-column: 1;
  }
  .center {
    grid-column: 2;
    justify-self: center;
  }
  .end,
  .contact {
    grid-column: 3;
    justify-self: end;
  }
  .end,
  nav,
  .contact {
    display: flex;
    align-items: baseline;
    gap: var(--space-24);
  }
  /* The current page in ink, the rest muted. */
  nav a:not([aria-current]) {
    color: var(--muted);
  }
  .end :global(.theme-toggle) {
    min-width: 0;
    min-height: 0;
  }

  /* Phone: two-row header in the flow (name + toggle, then nav), 44px targets. */
  @media (max-width: 639.98px) {
    .corner {
      position: static;
      padding: var(--frame-inset-block) var(--frame-inset) 0;
    }
    .top {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'name toggle' 'nav view';
      align-items: start;
    }
    .name {
      grid-area: name;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 44px;
    }
    .role {
      display: block;
    }
    .top .center {
      grid-area: view;
      justify-self: end;
    }
    .end {
      display: contents;
    }
    nav {
      grid-area: nav;
      gap: 0;
    }
    nav a {
      display: inline-flex;
      align-items: center;
      min-width: 44px;
      min-height: 44px;
      padding-right: var(--space-24);
    }
    /* Display stays with ThemeToggle, which hides it without JS. */
    .end :global(.theme-toggle) {
      grid-area: toggle;
      min-width: 44px;
      min-height: 44px;
    }
    /* Positioned, so it paints over the page's own positioned layers (the
       homepage strip's fade). */
    .bottom {
      position: relative;
      inset: auto;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: var(--space-24);
      padding-bottom: var(--frame-inset-block);
    }
    .bottom .start {
      margin-right: auto;
    }
  }
</style>
