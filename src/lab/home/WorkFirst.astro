---
// Layout 1, Work first. The first screen says who Nahuel is in one sentence,
// and the work already peeks up from its bottom edge. Then big two-column
// cards that show the product, then him (portrait, how he thinks), his
// experience, and the way to reach him.
//
// Combined (round 2): the same, with vers1ons leading My work as a feature
// with all its numbers and parts (from Lead project), the rest in a row of
// three, and the short list of how he thinks (from Split).
import EntryImage from '../../components/EntryImage.astro';
import { stillOf } from '../../lib/entries';
import { STEPS, work } from '../../lib/home';
import { EDITABLES } from '../editables';
import { settingsFor } from '../../lib/layout-settings';
import Experience from '../../components/home/Experience.astro';
import LeadFeature from '../../components/home/LeadFeature.astro';
import Reach from './Reach.astro';
import WorkCard from '../../components/home/WorkCard.astro';

interface Props {
  combined?: boolean;
}
const { combined = false } = Astro.props;

const WORK = work();
const [lead, ...rest] = WORK;
const id = combined ? 'combined' : 'work-first';
const { style, text } = settingsFor(id, EDITABLES[id]);
---
<main class="wf" data-layout style={style}>
  <section class="hello container" aria-labelledby="hello-title">
    <div class="say">
      <p class="kicker mono muted">Nahuel D'Elias · Product engineer</p>
      <h1 id="hello-title"><span data-edit="headline">{text.headline}</span> <span class="muted" data-edit="headline-tail">{text['headline-tail']}</span></h1>
    </div>
    <ul class="peek" aria-label="Projects">
      {WORK.map(({ entry, href }, i) => {
        return (
          <li style={`--i: ${i}`}>
            <a href={href} data-tip={entry.data.title} aria-label={entry.data.title}>
              <EntryImage src={stillOf(entry)} alt="" widths={[400, 800]} sizes="(max-width: 639px) 45vw, 22vw" loading="eager" />
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <div class="flow">
  <section class="part work container" data-section="work" aria-labelledby="work-title">
    <h2 class="section-title" id="work-title">My work</h2>
    {combined ? (
      <>
        <LeadFeature entry={lead.entry} href={lead.href} kicker={lead.kicker} level="h3" />
        <ul class="cards three">
          {rest.map(({ entry, href, kicker }) => (
            <li><WorkCard entry={entry} href={href} kicker={kicker} sizes="(max-width: 639px) 100vw, 33vw" /></li>
          ))}
        </ul>
      </>
    ) : (
      <ul class="cards">
        {WORK.map(({ entry, href, kicker }) => (
          <li><WorkCard entry={entry} href={href} kicker={kicker} sizes="(max-width: 639px) 100vw, 50vw" /></li>
        ))}
      </ul>
    )}
  </section>

  <section class="part me container" data-section="me" aria-labelledby="me-title">
    <div class="who">
      <canvas class="portrait" data-lab-portrait role="img" aria-label="A portrait of Nahuel D'Elias drawn in characters"></canvas>
    </div>
    <div class="about">
      <h2 class="section-title" id="me-title">About me</h2>
      <p class="statement" data-edit="statement">{text.statement}</p>
      <p class="statement muted" data-edit="closer">{text.closer}</p>
      <h3 class="label mono muted">How I think about product</h3>
      {combined ? (
        <ol class="short">
          {STEPS.map((s, i) => (
            <li><span class="mono muted">{String(i + 1).padStart(2, '0')}</span> {s.title}</li>
          ))}
        </ol>
      ) : (
        <ol class="steps">
          {STEPS.map((s, i) => (
            <li>
              <span class="no mono muted">{String(i + 1).padStart(2, '0')}</span>
              <span class="step-title">{s.title}</span>
              <span class="step-line muted">{s.line}</span>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <div class="part container" data-section="experience"><Experience /></div>
  <div class="part container" data-section="reach"><Reach /></div>
  </div>
</main>

<style>
  .wf {
    padding-bottom: var(--space-160);
  }

  /* The first screen: the sentence in the middle, the work hanging off the
     bottom edge so it's clear there's more. */
  .hello {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: 72px;
  }
  .say {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-48) 0;
    text-align: center;
  }
  .kicker {
    margin: 0;
    font-size: var(--text-mono);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }
  h1 {
    margin: var(--space-24) 0 0;
    max-width: calc(var(--headline-width) * 1ch);
    font-size: var(--headline);
    font-weight: var(--weight-medium);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }
  .peek {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-16);
    margin: 0 0 calc(-1 * var(--peek));
    padding: 0;
    list-style: none;
  }
  .peek li {
    /* A gentle stagger, so the row reads as a spread of work, not a grid. */
    transform: translateY(calc(var(--i) % 2 * 24px));
  }
  .peek a {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    background: var(--surface);
    outline: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    outline-offset: -1px;
    box-shadow: 0 12px 32px -16px color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .peek a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  .peek :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: no-preference) {
    .peek a {
      transition: transform 0.5s var(--ease);
    }
    .peek a:hover,
    .peek a:focus-visible {
      transform: translateY(-12px);
    }
  }

  .section-title {
    margin: 0 0 var(--space-32);
    font-size: var(--text-h2);
    font-weight: var(--weight-medium);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-h2);
  }
  /* The sections, in the order the editor set, below the work's peek. */
  .flow {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
    margin-top: calc(var(--peek) + var(--section-gap));
  }
  .part[data-section='work'] { order: var(--order-work); }
  .part[data-section='me'] { order: var(--order-me); }
  .part[data-section='experience'] { order: var(--order-experience); }
  .part[data-section='reach'] { order: var(--order-reach); }
  .cards {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--card-gap) var(--space-32);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Combined: the rest of the work under the feature, three across. */
  .cards.three {
    /* A step more than between the cards: 96px at the default 64px. */
    margin-top: calc(var(--card-gap) * 1.5);
  }
  /* Combined: how he thinks, as five short lines. */
  .short {
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-lead);
  }
  .short .mono {
    margin-right: var(--space-12);
    font-size: var(--text-mono);
  }

  .me {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-64);
    align-items: start;
  }
  .portrait {
    display: block;
    width: 100%;
    max-width: var(--portrait);
    aspect-ratio: 400 / 480;
  }
  :global(:root:not(.js)) .portrait {
    display: none;
  }
  .statement {
    margin: 0 0 var(--space-16);
    max-width: 52ch;
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
  }
  .label {
    margin: var(--space-48) 0 var(--space-16);
    font-size: var(--text-mono);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: var(--space-4) var(--space-16);
    padding: var(--space-16) 0;
    border-top: 1px solid var(--line);
  }
  .steps li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .no {
    grid-row: span 2;
    padding-top: 4px;
    font-size: var(--text-mono);
  }
  .step-title {
    font-size: var(--text-row-title);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-row-title);
  }
  .step-line {
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }

  @media (max-width: 899.98px) {
    .me {
      grid-template-columns: minmax(0, 1fr);
    }
    .cards {
      grid-template-columns: repeat(min(var(--cols), 2), minmax(0, 1fr));
    }
  }
  @media (max-width: 639.98px) {
    .hello {
      padding-top: var(--space-64);
    }
    .peek {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-bottom: -20vw;
    }
    .peek li {
      transform: translateY(calc(var(--i) % 2 * 16px));
    }
    h1 {
      font-size: var(--text-display);
    }
    .flow {
      gap: var(--space-96);
      margin-top: calc(20vw + var(--space-96));
    }
    .cards,
    .cards.three {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-48);
    }
    .cards.three {
      margin-top: var(--space-64);
    }
  }
</style>
