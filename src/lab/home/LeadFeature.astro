---
// The lead project as a feature: the product big on the left (its reel
// plays when pointed at), and on the right everything a recruiter needs to
// judge it, with every number from its impact row and every part.
import { Image } from 'astro:assets';
import Icon from '../../components/Icon.astro';
import { entryHref, entryNumber, partsOf, type Entry } from '../../lib/entries';
import { frameOf } from './frames';

interface Props {
  entry: Entry;
  href?: string;
  kicker: string;
  /** The title's level: h2 on its own, h3 under a "My work" heading. */
  level?: 'h2' | 'h3';
}

const { entry, href, kicker, level = 'h2' } = Astro.props;
const frame = frameOf(entry.id);
const parts = partsOf(entry);
const Title = level;
const id = `lead-${entry.id}`;
---
<article class="feature" aria-labelledby={id}>
  <a class="lead-shot" href={href} data-reel={entry.data.video} data-tip="Case study" tabindex="-1" aria-hidden="true">
    <span class="shot">
      {frame && <Image src={frame} alt="" widths={[800, 1600]} sizes="(max-width: 899px) 100vw, 66vw" loading="eager" />}
    </span>
  </a>
  <div class="side">
    <p class="kicker mono muted">{kicker}</p>
    <Title class="title" id={id}><a href={href}>{entry.data.title}</a></Title>
    <p class="line muted">{entry.data.tagline}</p>
    {entry.data.impact && (
      <ul class="numbers">
        {entry.data.impact.map((i) => <li><b>{i.value}</b><span class="muted">{i.label}</span></li>)}
      </ul>
    )}
    {parts.length > 0 && (
      <ol class="parts" aria-label={`${entry.data.title}, in parts`}>
        {parts.map((p) => (
          <li>
            <a href={entryHref(p)}>
              <span class="mono muted">{entryNumber(p)}</span>
              <span>{p.data.title}</span>
              <Icon name="arrow-right" />
            </a>
          </li>
        ))}
      </ol>
    )}
  </div>
</article>

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: var(--space-48);
    align-items: start;
  }
  .lead-shot {
    display: block;
    border-radius: 8px;
  }
  .shot {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    background: var(--surface);
    outline: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    outline-offset: -1px;
  }
  .shot :global(img),
  .shot :global(video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shot :global(video) {
    position: absolute;
    inset: 0;
    animation: arrive 0.45s ease both;
  }
  @keyframes arrive {
    from { opacity: 0; }
  }
  .kicker {
    margin: 0;
    font-size: var(--text-mono);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }
  .title {
    margin: var(--space-12) 0 var(--space-8);
    font-size: var(--text-meta-title);
    font-weight: var(--weight-medium);
    line-height: var(--leading-meta-title);
    letter-spacing: var(--tracking-meta-title);
  }
  .title a {
    color: inherit;
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .line {
    margin: 0;
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  .numbers {
    display: grid;
    gap: var(--space-16);
    margin: var(--space-32) 0 0;
    padding: 0;
    list-style: none;
  }
  .numbers li {
    display: grid;
    gap: var(--space-4);
  }
  .numbers b {
    font-size: var(--text-title);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-title);
  }
  .numbers span {
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  .parts {
    margin: var(--space-32) 0 0;
    padding: 0;
    list-style: none;
  }
  .parts a {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 16px;
    align-items: center;
    gap: var(--space-12);
    min-height: 44px;
    border-top: 1px solid var(--line);
    color: inherit;
    font-size: var(--text-small);
    text-decoration: none;
  }
  .parts li:last-child a {
    border-bottom: 1px solid var(--line);
  }
  .parts .mono {
    font-size: var(--text-mono);
    letter-spacing: var(--tracking-mono);
  }
  .parts :global(.icon) {
    color: var(--accent);
  }
  .parts a:hover span:nth-child(2) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  @media (prefers-reduced-motion: no-preference) {
    .parts :global(.icon) {
      transition: transform 0.25s var(--ease);
    }
    .parts a:hover :global(.icon) {
      transform: translateX(3px);
    }
  }
  @media (max-width: 899.98px) {
    .feature {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-24);
    }
  }
</style>
