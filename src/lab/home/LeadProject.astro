---
// Layout 2, Lead project. A short intro with the ways to reach Nahuel up
// front, then vers1ons as a big feature with every number and part, the
// rest of the work as a compact list, then him and his experience.
import { Image } from 'astro:assets';
import Icon from '../../components/Icon.astro';
import { cardImpact, entryHref, entryNumber, partsOf } from '../../lib/entries';
import { CLOSER, LINKS, RESUME, STATEMENT, work } from '../../lib/home';
import Experience from './Experience.astro';
import Reach from './Reach.astro';
import { frameOf } from './frames';

const [lead, ...rest] = work();
const leadFrame = frameOf(lead.entry.id);
const parts = partsOf(lead.entry);
---
<main class="lp">
  <section class="intro container" aria-labelledby="intro-title">
    <p class="kicker mono muted">Nahuel D'Elias · Product engineer</p>
    <h1 id="intro-title">I'm Nahuel, a product engineer who thinks through the entire product, <span class="muted">from the first conversation to something people use without thinking.</span></h1>
    <ul class="quick">
      <li><a href={RESUME} target="_blank" rel="noopener">Resume <Icon name="arrow-up-right" /></a></li>
      {LINKS.map((l) => (
        <li><a href={l.href} {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{l.label} <Icon name="arrow-up-right" /></a></li>
      ))}
    </ul>
  </section>

  <section class="feature container" aria-labelledby="lead-title">
    <a class="lead-shot" href={lead.href} data-reel={lead.entry.data.video} data-tip="Case study">
      <span class="shot">
        {leadFrame && <Image src={leadFrame} alt="" widths={[800, 1600]} sizes="(max-width: 899px) 100vw, 66vw" loading="eager" />}
      </span>
    </a>
    <div class="lead-side">
      <p class="kicker mono muted">{lead.kicker}</p>
      <h2 class="lead-title" id="lead-title"><a href={lead.href}>{lead.entry.data.title}</a></h2>
      <p class="lead-line muted">{lead.entry.data.tagline}</p>
      {lead.entry.data.impact && (
        <ul class="numbers">
          {lead.entry.data.impact.map((i) => <li><b>{i.value}</b><span class="muted">{i.label}</span></li>)}
        </ul>
      )}
      {parts.length > 0 && (
        <ol class="parts">
          {parts.map((p) => (
            <li>
              <a href={entryHref(p)}>
                <span class="mono muted">{entryNumber(p)}</span>
                <span>{p.data.title}</span>
                <Icon name="arrow-right" />
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <section class="more container" aria-labelledby="more-title">
    <h2 class="label mono muted" id="more-title">More work</h2>
    <ul class="list">
      {rest.map(({ entry, href, kicker }) => {
        const frame = frameOf(entry.id);
        const impact = cardImpact(entry);
        return (
          <li>
            <a class="item" href={href} data-reel={entry.data.video} data-tip="Case study">
              <span class="shot thumb">
                {frame && <Image src={frame} alt="" widths={[400, 800]} sizes="(max-width: 639px) 100vw, 280px" />}
              </span>
              <span class="item-text">
                <span class="kicker mono muted">{kicker}</span>
                <span class="item-title">{entry.data.title}</span>
                <span class="item-line muted">{entry.data.tagline}</span>
              </span>
              <span class="item-impact">{impact && <><b>{impact.value}</b> <span class="muted">{impact.label}</span></>}</span>
              <Icon name="arrow-right" />
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="me container" aria-labelledby="me-title">
    <canvas class="portrait" data-lab-portrait role="img" aria-label="A portrait of Nahuel D'Elias drawn in characters"></canvas>
    <div>
      <h2 class="label mono muted" id="me-title">About me</h2>
      <p class="statement">{STATEMENT}</p>
      <p class="statement muted">{CLOSER}</p>
    </div>
  </section>

  <div class="container below">
    <Experience />
    <Reach />
  </div>
</main>

<style>
  .lp {
    padding-top: 72px;
    padding-bottom: var(--space-160);
  }
  .kicker {
    margin: 0;
    font-size: var(--text-mono);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }
  .label {
    margin: 0 0 var(--space-16);
    font-size: var(--text-mono);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .intro {
    padding-top: var(--space-96);
  }
  h1 {
    margin: var(--space-16) 0 0;
    max-width: 30ch;
    font-size: var(--text-h2);
    font-weight: var(--weight-medium);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-h2);
    text-wrap: balance;
  }
  .quick {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-24);
    margin: var(--space-24) 0 0;
    padding: 0;
    list-style: none;
  }
  .quick a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: 44px;
    color: var(--ink);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }
  .quick :global(.icon) {
    color: var(--accent);
  }
  .quick a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* The lead project: the product big on the left, everything a recruiter
     needs to judge it on the right. */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: var(--space-48);
    align-items: start;
    margin-top: var(--space-64);
  }
  .shot {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    background: var(--surface);
    outline: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    outline-offset: -1px;
  }
  .shot :global(img),
  .shot :global(video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shot :global(video) {
    position: absolute;
    inset: 0;
    animation: arrive 0.45s ease both;
  }
  @keyframes arrive {
    from { opacity: 0; }
  }
  .lead-shot {
    display: block;
    border-radius: 8px;
  }
  .lead-title {
    margin: var(--space-12) 0 var(--space-8);
    font-size: var(--text-meta-title);
    font-weight: var(--weight-medium);
    line-height: var(--leading-meta-title);
    letter-spacing: var(--tracking-meta-title);
  }
  .lead-title a {
    color: inherit;
    text-decoration: none;
  }
  .lead-title a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .lead-line {
    margin: 0;
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  .numbers {
    display: grid;
    gap: var(--space-16);
    margin: var(--space-32) 0 0;
    padding: 0;
    list-style: none;
  }
  .numbers li {
    display: grid;
    gap: var(--space-4);
  }
  .numbers b {
    font-size: var(--text-title);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-title);
  }
  .numbers span {
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  .parts {
    margin: var(--space-32) 0 0;
    padding: 0;
    list-style: none;
  }
  .parts a {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 16px;
    align-items: center;
    gap: var(--space-12);
    min-height: 44px;
    border-top: 1px solid var(--line);
    color: inherit;
    font-size: var(--text-small);
    text-decoration: none;
  }
  .parts li:last-child a {
    border-bottom: 1px solid var(--line);
  }
  .parts .mono {
    font-size: var(--text-mono);
    letter-spacing: var(--tracking-mono);
  }
  .parts :global(.icon) {
    color: var(--accent);
  }
  .parts a:hover span:nth-child(2) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The rest: one row each, the product small beside what it is. */
  .more {
    margin-top: var(--space-160);
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .item {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr) minmax(0, 0.8fr) 16px;
    align-items: center;
    gap: var(--space-32);
    padding: var(--space-24) 0;
    border-top: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }
  .list li:last-child .item {
    border-bottom: 1px solid var(--line);
  }
  .item-text {
    display: grid;
    gap: var(--space-8);
  }
  .item-title {
    font-size: var(--text-title);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-title);
  }
  .item-line,
  .item-impact {
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  .item-impact b {
    font-weight: var(--weight-medium);
  }
  .item :global(.icon) {
    color: var(--accent);
  }
  .item:hover .item-title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .me {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: var(--space-48);
    align-items: center;
    margin-top: var(--space-160);
  }
  .portrait {
    display: block;
    width: 100%;
    aspect-ratio: 400 / 480;
  }
  :global(:root:not(.js)) .portrait {
    display: none;
  }
  .statement {
    margin: 0 0 var(--space-16);
    max-width: 56ch;
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
  }

  .below {
    display: flex;
    flex-direction: column;
    gap: var(--space-160);
    margin-top: var(--space-160);
  }

  a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  @media (prefers-reduced-motion: no-preference) {
    .parts :global(.icon),
    .item :global(.icon) {
      transition: transform 0.25s var(--ease);
    }
    .parts a:hover :global(.icon),
    .item:hover :global(.icon) {
      transform: translateX(3px);
    }
  }

  @media (max-width: 899.98px) {
    .feature {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-24);
    }
    .item {
      grid-template-columns: 200px minmax(0, 1fr) 16px;
    }
    .item-impact {
      display: none;
    }
  }
  @media (max-width: 639.98px) {
    .lp {
      padding-top: var(--space-16);
    }
    .intro {
      padding-top: var(--space-64);
    }
    .item {
      grid-template-columns: minmax(0, 1fr) 16px;
      gap: var(--space-16);
    }
    .thumb {
      grid-column: 1 / -1;
    }
    .item-impact {
      display: block;
      grid-column: 1;
    }
    .item :global(.icon) {
      grid-column: 2;
      grid-row: 2;
    }
    .me {
      grid-template-columns: minmax(0, 1fr);
    }
    .portrait {
      max-width: 240px;
    }
    .more,
    .me,
    .below {
      margin-top: var(--space-96);
    }
    .below {
      gap: var(--space-96);
    }
  }
</style>
