---
// Document shell: tokens, fonts, theme. Every page renders through this.
import '../styles/base.css';
import mono400 from '../assets/fonts/dm-mono-latin-400-normal.woff2?url';
import sans400 from '../assets/fonts/instrument-sans-latin-400-normal.woff2?url';
import sans500 from '../assets/fonts/instrument-sans-latin-500-normal.woff2?url';
import faviconSvg from '../assets/favicon.svg?raw';

const FACES = { 'sans-400': sans400, 'sans-500': sans500, 'mono-400': mono400 };
export type Face = keyof typeof FACES;

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Faces used above the fold. Only these are preloaded; the rest load on use. */
  preload?: Face[];
}

const { title, description, noindex = false, preload = ['sans-400', 'sans-500'] } = Astro.props;

// Inline, as a data URI: a favicon request in flight before the largest
// paint counts toward LCP under simulated 4G (~150ms on /).
const favicon = `data:image/svg+xml,${encodeURIComponent(faviconSvg.trim())}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Before first paint: mark that JS runs (controls that need it show only
        then), apply a saved theme choice, and define afterPaint(f): run f
        once the first content has painted (the first largest-contentful-paint
        entry), or a second after load where that isn't reported. Below-the-
        fold styles and behaviours load through it (DeferredStyles,
        AfterLoad), so nothing they fetch is on the way to the first paint.
        Must stay tiny and inline. */}
    <script is:inline>var d=document.documentElement;d.classList.add("js");try{var t=localStorage.getItem("theme");if(t==="light"||t==="dark")d.dataset.theme=t}catch(e){}var q=[],p=0;function g(){if(!p){p=1;setTimeout(function(){q.forEach(function(f){f()});q=null},0)}}window.afterPaint=function(f){q?q.push(f):setTimeout(f,0)};try{new PerformanceObserver(function(){requestAnimationFrame(g)}).observe({type:"largest-contentful-paint",buffered:true})}catch(e){}addEventListener("load",function(){setTimeout(g,1000)})</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {preload.map((face) => <link rel="preload" href={FACES[face]} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
