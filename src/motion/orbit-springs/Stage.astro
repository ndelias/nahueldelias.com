---
// M09, orbit springs (piece.ts): a row of cards, one forward, carried by
// the same springs as /work's constellation; dials for stiffness and
// damping; and the curve one card follows with those settings.
const CARDS = 5;
---
<div class="lab" data-lab>
  <div class="row" data-row>
    {Array.from({ length: CARDS }, (_, i) => (
      <button type="button" class={`card c${i}`} aria-label={`Card ${i + 1}`} aria-pressed={i === 2 ? 'true' : 'false'} data-card={i}></button>
    ))}
  </div>
  <div class="panel">
    <svg class="curve" viewBox="0 0 120 48" preserveAspectRatio="none" aria-hidden="true">
      <line x1="0" y1="12" x2="120" y2="12" class="target" />
      <path d="" data-curve />
    </svg>
    <label class="dial mono"><span>Stiffness</span><input type="range" min="20" max="400" step="5" value="95" data-k /><output data-k-out>95</output></label>
    <label class="dial mono"><span>Damping</span><input type="range" min="0.15" max="1.5" step="0.05" value="1" data-z /><output data-z-out>1.00 · critical</output></label>
  </div>
</div>
