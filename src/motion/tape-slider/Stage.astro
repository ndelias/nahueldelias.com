---
// M04, the tape slider, rebuilt from vers1ons' audio editor: speed, pitch
// and gain, each a ruler of ticks pulled under a fixed playhead (piece.ts).
// Values and ranges are the product's. Until the piece mounts (and without
// JS), a still ruler stands in for each tape.
const ROWS = [
  { id: 'speed', label: 'Speed', value: '100%' },
  { id: 'pitch', label: 'Pitch', value: '0 st' },
  { id: 'gain', label: 'Gain', value: '0 dB' },
];
---
<div class="editor" data-editor>
  <div class="bar">
    <button type="button" class="vari mono" aria-pressed="false" data-vari>Varispeed</button>
    <button type="button" class="reset mono" data-reset>Reset</button>
  </div>
  {ROWS.map(({ id, label, value }) => (
    <div class="row" data-row={id}>
      <span class="label mono" id={`tape-${id}`}>{label}</span>
      <div class="tape"><canvas aria-labelledby={`tape-${id}`}></canvas></div>
      <span class="value mono" data-value>{value}</span>
    </div>
  ))}
  <span class="wall-probe" aria-hidden="true"></span>
</div>

<style>
  .editor {
    display: grid;
    gap: 8px;
    width: min(100%, 480px);
    padding: 12px;
    border-radius: 12px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 2px 4px;
  }
  .bar button {
    padding: 4px 8px;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--muted);
    font-size: var(--text-mono-sm);
    cursor: pointer;
  }
  .bar button:hover {
    color: var(--ink);
  }
  .bar .vari {
    background: var(--surface);
  }
  .bar .vari[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
  }
  .row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) 4rem;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--surface);
    transition: opacity 200ms var(--ease);
  }
  .row.off {
    opacity: 0.4;
    pointer-events: none;
  }
  .label,
  .value {
    font-size: var(--text-mono);
    color: var(--muted);
  }
  .value {
    text-align: right;
    color: var(--ink);
  }
  /* The tape's ends fade, as in the product. */
  .tape {
    position: relative;
    height: 32px;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: ew-resize;
    touch-action: pan-y;
    border-radius: 4px;
  }
  /* The ring goes on the row: the tape's fading ends would fade it too. */
  canvas:focus-visible {
    outline: none;
  }
  .row:has(canvas:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }
  /* The still ruler before the piece mounts: even ticks, the playhead. */
  .editor:not(.on) .tape {
    background:
      linear-gradient(var(--ink), var(--ink)) center / 2px 20px no-repeat,
      repeating-linear-gradient(to right, color-mix(in srgb, var(--ink) 25%, transparent) 0 1px, transparent 1px 8px) center / 100% 10px no-repeat;
  }
  .wall-probe {
    display: none;
    color: var(--warn);
  }
</style>
