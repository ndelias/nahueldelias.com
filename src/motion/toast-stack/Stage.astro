---
// M12, the toast stack (piece.ts): a button that raises notices, and the
// stack they collect in at the bottom of the stage.
---
<div class="toasts" data-toasts>
  <button type="button" class="raise" data-raise>Save draft</button>
  <ol class="stack" aria-live="polite" aria-label="Notifications" data-stack></ol>
</div>
