---
// M02, hold to sign: a press-and-hold confirm (piece.ts). The fill is a
// second, inverted copy of the label clipped to the progress, so the words
// turn over as the ink passes them. Once it's done, the label gives way to
// "Signed" and a check that draws itself, then it resets.
---
<button type="button" class="hold" data-hold>
  <span class="face">Hold to sign</span>
  <span class="face fill" aria-hidden="true">Hold to sign</span>
  <span class="face done" aria-hidden="true">
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" pathLength="1" /></svg>
    Signed
  </span>
</button>
<p class="visually-hidden" aria-live="polite" data-status></p>

<style>
  .hold {
    position: relative;
    display: grid;
    width: 220px;
    height: 56px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink);
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    cursor: pointer;
    /* A finger that drifts while holding mustn't turn into a scroll and
       cancel the hold. */
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    transition: transform 160ms var(--ease);
  }
  .hold.held {
    transform: scale(0.97);
  }
  /* Positioned with explicit layers: the fill's clip-path would otherwise
     paint it over "Signed" whenever that's at full opacity (an element at
     opacity 1 drops back to ordinary paint order, under the clipped fill). */
  .face {
    position: relative;
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: inherit;
  }
  .fill,
  .done {
    background: var(--ink);
    color: var(--bg);
  }
  .fill {
    z-index: 1;
    clip-path: inset(0 calc(100% - var(--p, 0) * 100%) 0 0);
  }
  .done {
    z-index: 2;
    opacity: 0;
    transition: opacity 240ms var(--ease);
  }
  .done svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Undrawn again only once "Signed" has faded out, not under it. */
  .done path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0s linear 240ms;
  }
  .hold.is-done .done {
    opacity: 1;
  }
  .hold.is-done .done path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 420ms var(--ease) 120ms;
  }
</style>
