---
// M01, the spring toggle: a segmented control whose filled pill moves on
// two springs, one per edge (piece.ts). The pill is a second, inverted copy
// of the labels clipped to the pill's edges, so the text under it turns
// over exactly where the pill is, mid-flight too. Until the piece mounts
// (and without JS), the chosen option is simply filled.
const OPTIONS = ['Original', 'Instrumental', 'Vocals', 'Stems'];
---
<div class="toggle" data-toggle>
  <div class="row" role="radiogroup" aria-label="Version">
    {OPTIONS.map((label, i) => (
      <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{label}</button>
    ))}
  </div>
  <div class="row ink" aria-hidden="true">{OPTIONS.map((label) => <span>{label}</span>)}</div>
</div>

<style>
  .toggle {
    position: relative;
    display: inline-flex;
    max-width: 100%;
    padding: 4px;
    border-radius: 999px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: var(--text-small);
    line-height: 20px;
    user-select: none;
    -webkit-user-select: none;
  }
  .row {
    display: flex;
  }
  .row > * {
    padding: 10px 18px;
    border: 0;
    border-radius: 999px;
    white-space: nowrap;
  }
  button {
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  button:hover {
    color: var(--ink);
  }
  button:focus-visible {
    outline-offset: 2px;
  }
  .ink {
    position: absolute;
    inset: 4px;
    background: var(--ink);
    color: var(--bg);
    clip-path: inset(0 100% 0 0 round 999px);
    pointer-events: none;
  }
  .toggle:not(.on) [aria-checked='true'] {
    background: var(--ink);
    color: var(--bg);
  }
  .toggle:not(.on) .ink {
    visibility: hidden;
  }
  /* Phone: all four fit a 390px screen's stage. */
  @media (max-width: 639.98px) {
    .toggle {
      font-size: var(--text-caption);
    }
    .row > * {
      padding-inline: 10px;
    }
  }
</style>
